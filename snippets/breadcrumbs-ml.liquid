{{ 'theme-ml-custom.css' | asset_url | stylesheet_tag }}

{%- unless template == 'index' or template == 'cart' or template == 'list-collections' or template == '404' -%}
  {%- assign t = template | split: '.' | first -%}

  <nav class="breadcrumbs-ml container-ml" aria-label="breadcrumb">
    <a href="{{ routes.root_url }}" class="breadcrumbs-ml__link">Inicio</a>
    <span class="breadcrumbs-ml__separator">›</span>

    {%- case t -%}
      {%- when 'page' -%}
        <span class="breadcrumbs-ml__item">{{ page.title }}</span>

      {%- when 'product' -%}
        {%- if collection.url -%}
          <a href="{{ collection.url }}" class="breadcrumbs-ml__link">{{ collection.title }}</a>
          <span class="breadcrumbs-ml__separator">›</span>
        {%- endif -%}
        <span class="breadcrumbs-ml__item">{{ product.title }}</span>

      {%- when 'collection' and collection.handle -%}
        {%- if current_tags -%}
          <a href="{{ collection.url }}" class="breadcrumbs-ml__link">{{ collection.title }}</a>
          <span class="breadcrumbs-ml__separator">›</span>
          <span class="breadcrumbs-ml__item">{{ current_tags | join: ", " }}</span>
        {%- else -%}
          <span class="breadcrumbs-ml__item">{{ collection.title }}</span>
        {%- endif -%}

      {%- when 'blog' -%}
        {%- if current_tags -%}
          <a href="{{ blog.url }}" class="breadcrumbs-ml__link">{{ blog.title }}</a>
          <span class="breadcrumbs-ml__separator">›</span>
          <span class="breadcrumbs-ml__item">{{ current_tags | join: ", " }}</span>
        {%- else -%}
          <span class="breadcrumbs-ml__item">{{ blog.title }}</span>
        {%- endif -%}

      {%- when 'article' -%}
        <a href="{{ blog.url }}" class="breadcrumbs-ml__link">{{ blog.title }}</a>
        <span class="breadcrumbs-ml__separator">›</span>
        <span class="breadcrumbs-ml__item">{{ article.title }}</span>

      {%- else -%}
        <span class="breadcrumbs-ml__item">{{ page_title }}</span>

    {%- endcase -%}
  </nav>
{%- endunless -%}
