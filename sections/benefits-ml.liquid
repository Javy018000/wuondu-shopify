{{ 'theme-ml-custom.css' | asset_url | stylesheet_tag }}

<div class="benefits-ml">
  <div class="container-ml">
    <div class="benefits-ml__grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'benefit' -%}
            <div class="benefit-card-ml" {{ block.shopify_attributes }}>
              <div class="benefit-card-ml__icon">
                {%- case block.settings.icon -%}
                  {%- when 'shipping' -%}
                    <svg fill="currentColor" viewBox="0 0 24 24" width="24" height="24">
                      <path d="M18 18.5c.83 0 1.5-.67 1.5-1.5s-.67-1.5-1.5-1.5-1.5.67-1.5 1.5.67 1.5 1.5 1.5zM19.5 9.5h-1V6c0-.55-.45-1-1-1h-11c-.55 0-1 .45-1 1v9c0 .55.45 1 1 1h.76c-.4.54-.76 1.2-.76 2 0 1.66 1.34 3 3 3s3-1.34 3-3c0-.8-.36-1.46-.76-2h3.51c-.4.54-.75 1.2-.75 2 0 1.66 1.34 3 3 3s3-1.34 3-3c0-.8-.35-1.46-.75-2h.75c.55 0 1-.45 1-1v-3.5c0-.83-.67-1.5-1.5-1.5zm-9.5 9c-.83 0-1.5-.67-1.5-1.5S9.17 15.5 10 15.5s1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm7.5-9.5h-5V7h5v2z"/>
                    </svg>
                  {%- when 'payment' -%}
                    <svg fill="currentColor" viewBox="0 0 24 24" width="24" height="24">
                      <path d="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z"/>
                    </svg>
                  {%- when 'security' -%}
                    <svg fill="currentColor" viewBox="0 0 24 24" width="24" height="24">
                      <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
                    </svg>
                  {%- when 'returns' -%}
                    <svg fill="currentColor" viewBox="0 0 24 24" width="24" height="24">
                      <path d="M9 11H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2zm2-7h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11z"/>
                    </svg>
                  {%- when 'support' -%}
                    <svg fill="currentColor" viewBox="0 0 24 24" width="24" height="24">
                      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/>
                    </svg>
                  {%- when 'quality' -%}
                    <svg fill="currentColor" viewBox="0 0 24 24" width="24" height="24">
                      <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                    </svg>
                  {%- when 'discount' -%}
                    <svg fill="currentColor" viewBox="0 0 24 24" width="24" height="24">
                      <path d="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.42l9 9c.36.36.86.58 1.41.58.55 0 1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41 0-.55-.23-1.06-.59-1.42zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 7z"/>
                    </svg>
                  {%- else -%}
                    <svg fill="currentColor" viewBox="0 0 24 24" width="24" height="24">
                      <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                    </svg>
                {%- endcase -%}
              </div>

              <div class="benefit-card-ml__content">
                <h3 class="benefit-card-ml__title">{{ block.settings.title }}</h3>
                <p class="benefit-card-ml__description">{{ block.settings.description }}</p>
              </div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Beneficios ML",
  "class": "benefits-ml-section",
  "settings": [],
  "blocks": [
    {
      "type": "benefit",
      "name": "Beneficio",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícono",
          "options": [
            { "value": "shipping", "label": "Envíos" },
            { "value": "payment", "label": "Pagos" },
            { "value": "security", "label": "Seguridad" },
            { "value": "returns", "label": "Devoluciones" },
            { "value": "support", "label": "Soporte" },
            { "value": "quality", "label": "Calidad" },
            { "value": "discount", "label": "Descuentos" },
            { "value": "check", "label": "Check" }
          ],
          "default": "shipping"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Envío gratis"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Descripción",
          "default": "En compras superiores a $50.000"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Beneficios ML",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "shipping",
            "title": "Envío gratis",
            "description": "En compras superiores a $50.000"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "payment",
            "title": "Pago seguro",
            "description": "Múltiples métodos de pago"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "security",
            "title": "Compra protegida",
            "description": "Garantía en todos los productos"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "returns",
            "title": "Devoluciones fáciles",
            "description": "30 días para devoluciones"
          }
        }
      ]
    }
  ]
}
{% endschema %}
