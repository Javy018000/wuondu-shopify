<section class="benefits-ml" style="background: {{ section.settings.background_color }};">
  <div class="benefits-ml__container page-width">

    {% if section.settings.heading != blank %}
      <h2 class="benefits-ml__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="benefits-ml__grid benefits-ml__layout-{{ section.settings.layout }}">
        {% for block in section.blocks %}
          <div class="benefits-ml__item" {{ block.shopify_attributes }}>
            {% if block.settings.icon != blank %}
              <div class="benefits-ml__icon">
                {% case block.settings.icon %}
                  {% when 'shipping' %}
                    {% render 'icon-truck' %}
                  {% when 'security' %}
                    {% render 'icon-lock' %}
                  {% when 'payment' %}
                    {% render 'icon-credit-card' %}
                  {% when 'returns' %}
                    {% render 'icon-refresh' %}
                  {% when 'support' %}
                    {% render 'icon-headset' %}
                  {% else %}
                    {% render 'icon-check' %}
                {% endcase %}
              </div>
            {% endif %}

            <h3 class="benefits-ml__title">{{ block.settings.title }}</h3>

            {% if block.settings.description != blank %}
              <p class="benefits-ml__desc">{{ block.settings.description }}</p>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  .benefits-ml {
    padding: 60px 0;
  }

  .benefits-ml__heading {
    text-align: center;
    margin-bottom: 40px;
    font-size: 32px;
    font-weight: 700;
  }

  .benefits-ml__grid {
    display: grid;
    gap: 28px;
  }

  /* Layouts */
  .benefits-ml__layout-3 { grid-template-columns: repeat(3, 1fr); }
  .benefits-ml__layout-4 { grid-template-columns: repeat(4, 1fr); }
  .benefits-ml__layout-2 { grid-template-columns: repeat(2, 1fr); }

  @media (max-width: 800px) {
    .benefits-ml__layout-3,
    .benefits-ml__layout-4,
    .benefits-ml__layout-2 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 500px) {
    .benefits-ml__layout-3,
    .benefits-ml__layout-4,
    .benefits-ml__layout-2 {
      grid-template-columns: 1fr;
    }
  }

  .benefits-ml__item {
    background: white;
    padding: 26px 20px;
    border-radius: 16px;
    text-align: center;
    border: 1px solid rgba(0,0,0,0.06);
    transition: transform .25s ease, box-shadow .25s ease;
  }

  .benefits-ml__item:hover {
    transform: translateY(-6px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.06);
  }

  .benefits-ml__icon svg {
    width: 44px;
    height: 44px;
    margin: 0 auto 12px;
  }

  .benefits-ml__title {
    font-size: 20px;
    font-weight: 600;
    margin-bottom: 10px;
  }

  .benefits-ml__desc {
    color: #666;
    font-size: 15px;
  }
</style>

{% schema %}
{
  "name": "Beneficios Premium",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título de sección",
      "default": "¿Por qué elegirnos?"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Número de columnas",
      "options": [
        { "value": "3", "label": "3 columnas" },
        { "value": "4", "label": "4 columnas" },
        { "value": "2", "label": "2 columnas" }
      ],
      "default": "3"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#F7F7F7"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Beneficio",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícono",
          "options": [
            { "value": "shipping", "label": "Envío" },
            { "value": "security", "label": "Seguridad" },
            { "value": "payment", "label": "Pago" },
            { "value": "returns", "label": "Devoluciones" },
            { "value": "support", "label": "Soporte" },
            { "value": "check", "label": "Check" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Título del beneficio"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Descripción",
          "default": "Breve descripción del beneficio"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Beneficios Premium",
      "category": "Custom"
    }
  ]
}
{% endschema %}
