{{ 'theme-ml-custom.css' | asset_url | stylesheet_tag }}
{{ 'theme-ml-visual-enhancements.css' | asset_url | stylesheet_tag }}

<!-- Separador decorativo superior -->
<div class="section-wave-divider section-wave-divider--white section-wave-divider--bottom"></div>

<div class="categories-ml section-categories-ml" style="background-color: {{ section.settings.background_color }};">
  <div class="page-width">
    {%- comment -%} Encabezado de la sección {%- endcomment -%}
    {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
      <div class="categories-ml__header">
        {%- if section.settings.title != blank -%}
          <h2 class="categories-ml__title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="categories-ml__subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} Grid de categorías {%- endcomment -%}
    <div class="categories-ml__grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'category' -%}
            <a
              href="{{ block.settings.category_link }}"
              class="category-card-ml"
              {{ block.shopify_attributes }}
            >
              {%- comment -%} Icono de la categoría {%- endcomment -%}
              <div class="category-card-ml__icon">
                {%- case block.settings.icon_type -%}
                  {%- when 'electronics' -%}
                    <svg fill="currentColor" viewBox="0 0 24 24" width="32" height="32">
                      <path d="M21 2H3c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h7l-2 3v1h8v-1l-2-3h7c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 12H3V4h18v10z"/>
                    </svg>
                  {%- when 'fashion' -%}
                    <svg fill="currentColor" viewBox="0 0 24 24" width="32" height="32">
                      <path d="M16 6l2.29 2.29-4.88 4.88-4-4L2 16.59 3.41 18l6-6 4 4 6.3-6.29L22 12V6h-6z"/>
                      <path d="M15.5 2c-1.25 0-2.45.2-3.57.57-.35.11-.74.25-1.17.47-.43-.22-.82-.36-1.17-.47C8.45 2.2 7.25 2 6 2 2.5 2 2 4.18 2 6.5V9h4V6.5C6 5.5 6 4 8 4c.37 0 .8.03 1.28.1L6 12h12l-3.28-7.9c.48-.07.91-.1 1.28-.1 2 0 2 1.5 2 2.5V9h4V6.5C22 4.18 21.5 2 18 2h-2.5z"/>
                    </svg>
                  {%- when 'home' -%}
                    <svg fill="currentColor" viewBox="0 0 24 24" width="32" height="32">
                      <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
                    </svg>
                  {%- when 'sports' -%}
                    <svg fill="currentColor" viewBox="0 0 24 24" width="32" height="32">
                      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 3.3l1.35-.95c1.82.56 3.37 1.76 4.38 3.34l-.39 1.34-1.35.46L15 6.7V5.3zm-3.35-.95L11 5.3v1.4L9.01 9.49l-1.35-.46-.39-1.34c1.01-1.58 2.56-2.78 4.38-3.34zM7.08 17.11l-1.14.1C4.73 15.81 4 13.99 4 12c0-.12.01-.23.01-.35l1-.73 1.38.48 1.46 4.34-.77 1.37zm7.42 2.48c-.79.26-1.63.41-2.5.41s-1.71-.15-2.5-.41l-.69-1.49.64-1.1h5.11l.64 1.11-.7 1.48zM14.27 15H9.73l-1.35-4.02L12 8.44l3.63 2.54L14.27 15zm-3.55 4.55l1.14-.1-.77-1.37 1.46-4.34 1.39-.47 1 .73c0 .12.01.23.01.35 0 1.99-.73 3.81-1.94 5.21l-1.29-.01z"/>
                    </svg>
                  {%- when 'toys' -%}
                    <svg fill="currentColor" viewBox="0 0 24 24" width="32" height="32">
                      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8 0-1.48.41-2.86 1.12-4.06l1.46 1.46C6.21 10.24 6 11.1 6 12c0 3.31 2.69 6 6 6 1.52 0 2.9-.57 3.95-1.5l1.42 1.42C15.83 19.39 14.02 20 12 20zm6.88-4.06l-1.42-1.42C17.79 13.76 18 12.9 18 12c0-3.31-2.69-6-6-6-1.19 0-2.3.35-3.24.95L7.3 5.49C8.67 4.56 10.28 4 12 4c4.41 0 8 3.59 8 8 0 1.48-.41 2.86-1.12 4.06z"/>
                      <circle cx="12" cy="12" r="2"/>
                    </svg>
                  {%- when 'beauty' -%}
                    <svg fill="currentColor" viewBox="0 0 24 24" width="32" height="32">
                      <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                    </svg>
                  {%- when 'books' -%}
                    <svg fill="currentColor" viewBox="0 0 24 24" width="32" height="32">
                      <path d="M18 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 4h5v8l-2.5-1.5L6 12V4z"/>
                    </svg>
                  {%- when 'food' -%}
                    <svg fill="currentColor" viewBox="0 0 24 24" width="32" height="32">
                      <path d="M8.1 13.34l2.83-2.83L3.91 3.5c-1.56 1.56-1.56 4.09 0 5.66l4.19 4.18zm6.78-1.81c1.53.71 3.68.21 5.27-1.38 1.91-1.91 2.28-4.65.81-6.12-1.46-1.46-4.2-1.1-6.12.81-1.59 1.59-2.09 3.74-1.38 5.27L3.7 19.87l1.41 1.41L12 14.41l6.88 6.88 1.41-1.41L13.41 13l1.47-1.47z"/>
                    </svg>
                  {%- when 'automotive' -%}
                    <svg fill="currentColor" viewBox="0 0 24 24" width="32" height="32">
                      <path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16c-.83 0-1.5-.67-1.5-1.5S5.67 13 6.5 13s1.5.67 1.5 1.5S7.33 16 6.5 16zm11 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zM5 11l1.5-4.5h11L19 11H5z"/>
                    </svg>
                  {%- when 'pets' -%}
                    <svg fill="currentColor" viewBox="0 0 24 24" width="32" height="32">
                      <circle cx="4.5" cy="9.5" r="2.5"/>
                      <circle cx="9" cy="5.5" r="2.5"/>
                      <circle cx="15" cy="5.5" r="2.5"/>
                      <circle cx="19.5" cy="9.5" r="2.5"/>
                      <path d="M17.34 14.86c-.87-1.02-1.6-1.89-2.48-2.91-.46-.54-1.05-1.08-1.75-1.32-.11-.04-.22-.07-.33-.09-.25-.04-.52-.04-.78-.04s-.53 0-.79.05c-.11.02-.22.05-.33.09-.7.24-1.28.78-1.75 1.32-.87 1.02-1.6 1.89-2.48 2.91-1.31 1.31-2.92 2.76-2.62 4.79.29 1.02 1.02 2.03 2.33 2.32.73.15 3.06-.44 5.54-.44h.18c2.48 0 4.81.58 5.54.44 1.31-.29 2.04-1.31 2.33-2.32.31-2.04-1.3-3.49-2.61-4.8z"/>
                    </svg>
                  {%- when 'music' -%}
                    <svg fill="currentColor" viewBox="0 0 24 24" width="32" height="32">
                      <path d="M12 3v9.28c-.47-.17-.97-.28-1.5-.28C8.01 12 6 14.01 6 16.5S8.01 21 10.5 21c2.31 0 4.2-1.75 4.45-4H15V6h4V3h-7z"/>
                    </svg>
                  {%- else -%}
                    <svg fill="currentColor" viewBox="0 0 24 24" width="32" height="32">
                      <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"/>
                    </svg>
                {%- endcase -%}
              </div>

              {%- comment -%} Título de la categoría {%- endcomment -%}
              <h3 class="category-card-ml__title">{{ block.settings.category_name }}</h3>
            </a>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    {%- comment -%} Botón "Ver todas" (opcional) {%- endcomment -%}
    {%- if section.settings.show_view_all and section.settings.view_all_link != blank -%}
      <div class="categories-ml__view-all-wrapper">
        <a href="{{ section.settings.view_all_link }}" class="categories-ml__view-all-button">
          {{ section.settings.view_all_text }}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

<!-- Separador decorativo inferior -->
<div class="section-wave-divider section-wave-divider--bottom"></div>

<style>
  /* ========== Header de la sección ========== */
  .categories-ml__header {
    text-align: center;
    margin-bottom: 40px;
  }

  .categories-ml__title {
    font-size: 28px;
    font-weight: 400;
    color: #333;
    margin: 0 0 8px 0;
  }

  .categories-ml__subtitle {
    font-size: 16px;
    color: #666;
    margin: 0;
  }

  /* ========== Grid de categorías ========== */
  .categories-ml__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 20px;
    margin-bottom: 32px;
  }

  @media (min-width: 750px) {
    .categories-ml__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }
  }

  @media (min-width: 990px) {
    .categories-ml__grid {
      grid-template-columns: repeat(6, 1fr);
      gap: 24px;
    }
  }

  /* ========== Botón "Ver todas" ========== */
  .categories-ml__view-all-wrapper {
    text-align: center;
    margin-top: 32px;
  }

  .categories-ml__view-all-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 32px;
    background: #fff;
    color: #FF6600;
    border: 2px solid #FF6600;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .categories-ml__view-all-button:hover {
    background: #FF6600;
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(255, 102, 0, 0.3);
  }

  .categories-ml__view-all-button svg {
    transition: transform 0.3s ease;
  }

  .categories-ml__view-all-button:hover svg {
    transform: translateX(4px);
  }

  /* ========== Responsive ========== */
  @media (max-width: 749px) {
    .categories-ml__header {
      margin-bottom: 28px;
    }

    .categories-ml__title {
      font-size: 24px;
    }

    .categories-ml__subtitle {
      font-size: 14px;
    }

    .categories-ml__grid {
      grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
      gap: 16px;
    }
  }
</style>

