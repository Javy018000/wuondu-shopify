{{ 'category-grid-wuondu.css' | asset_url | stylesheet_tag }}

<div class="category-grid-wuondu" style="background-color: {{ section.settings.section_bg_color }};">
  <div class="page-width">

    {% comment %} TÍTULO DE LA SECCIÓN {% endcomment %}
    {% if section.settings.show_title %}
      <div class="category-grid-header">
        <h2 class="category-grid-title" style="color: {{ section.settings.title_color }};">
          {{ section.settings.section_title }}
        </h2>
        {% if section.settings.show_subtitle %}
          <p class="category-grid-subtitle" style="color: {{ section.settings.subtitle_color }};">
            {{ section.settings.section_subtitle }}
          </p>
        {% endif %}
      </div>
    {% endif %}

    {% comment %} GRID DE CATEGORÍAS {% endcomment %}
    <div
      class="category-grid-container"
      style="--grid-columns-desktop: {{ section.settings.columns_desktop }}; --grid-columns-mobile: {{ section.settings.columns_mobile }}; gap: {{ section.settings.grid_gap }}px;"
    >
      {% for block in section.blocks %}
        {% case block.type %}

          {% comment %} TARJETA GRANDE {% endcomment %}
          {% when 'large_card' %}
            <a
              href="{{ block.settings.card_link }}"
              class="category-card category-card--large"
              style="
                background-image: linear-gradient({{ block.settings.overlay_direction }}, {{ block.settings.overlay_color }}, {{ block.settings.overlay_color_end }}), url('{{ block.settings.card_image | image_url: width: 800 }}');
                grid-column: span {{ block.settings.card_width }};
                grid-row: span {{ block.settings.card_height }};
              "
              {{ block.shopify_attributes }}
            >
              <div class="category-card-content">
                {% if block.settings.show_badge %}
                  <span class="category-badge" style="background-color: {{ block.settings.badge_bg }}; color: {{ block.settings.badge_text_color }};">
                    {% if block.settings.badge_icon == 'lightning' %}⚡{% endif %}
                    {% if block.settings.badge_icon == 'fire' %}🔥{% endif %}
                    {% if block.settings.badge_icon == 'star' %}⭐{% endif %}
                    {% if block.settings.badge_icon == 'gift' %}🎁{% endif %}
                    {{ block.settings.badge_text }}
                  </span>
                {% endif %}

                <div class="category-card-text">
                  <h3 class="category-card-title" style="color: {{ block.settings.title_color }}; font-size: {{ block.settings.title_size }}px;">
                    {{ block.settings.card_title }}
                  </h3>
                  {% if block.settings.show_description %}
                    <p class="category-card-description" style="color: {{ block.settings.description_color }};">
                      {{ block.settings.card_description }}
                    </p>
                  {% endif %}
                  {% if block.settings.show_button %}
                    <span class="category-card-button" style="background-color: {{ block.settings.button_bg }}; color: {{ block.settings.button_text_color }};">
                      {{ block.settings.button_text }}
                    </span>
                  {% endif %}
                </div>

                {% if block.settings.show_icon %}
                  <div class="category-card-icon">
                    {% if block.settings.icon_image != blank %}
                      <img src="{{ block.settings.icon_image | image_url: width: 100 }}" alt="{{ block.settings.card_title }}">
                    {% else %}
                      <div class="category-card-icon-placeholder" style="background-color: {{ block.settings.icon_bg }}; color: {{ block.settings.icon_color }};">
                        {{ block.settings.icon_text }}
                      </div>
                    {% endif %}
                  </div>
                {% endif %}

                {% if block.settings.show_countdown %}
                  <div class="category-countdown" data-end-date="{{ block.settings.countdown_date }}">
                    <div class="countdown-item">
                      <span class="countdown-value" data-days>00</span>
                      <span class="countdown-label">D</span>
                    </div>
                    <span class="countdown-separator">:</span>
                    <div class="countdown-item">
                      <span class="countdown-value" data-hours>00</span>
                      <span class="countdown-label">H</span>
                    </div>
                    <span class="countdown-separator">:</span>
                    <div class="countdown-item">
                      <span class="countdown-value" data-minutes>00</span>
                      <span class="countdown-label">M</span>
                    </div>
                  </div>
                {% endif %}
              </div>
            </a>

          {% comment %} TARJETA PEQUEÑA/NORMAL {% endcomment %}
          {% when 'small_card' %}
            <a
              href="{{ block.settings.card_link }}"
              class="category-card category-card--small"
              style="
                background-color: {{ block.settings.card_bg }};
                background-image: {% if block.settings.card_image != blank %}linear-gradient({{ block.settings.overlay_direction }}, {{ block.settings.overlay_color }}, {{ block.settings.overlay_color_end }}), url('{{ block.settings.card_image | image_url: width: 400 }}'){% endif %};
                grid-column: span {{ block.settings.card_width }};
              "
              {{ block.shopify_attributes }}
            >
              <div class="category-card-content category-card-content--{{ block.settings.content_alignment }}">
                {% if block.settings.show_badge %}
                  <span class="category-badge category-badge--small" style="background-color: {{ block.settings.badge_bg }}; color: {{ block.settings.badge_text_color }};">
                    {{ block.settings.badge_text }}
                  </span>
                {% endif %}

                <div class="category-card-text">
                  <h3 class="category-card-title category-card-title--small" style="color: {{ block.settings.title_color }};">
                    {{ block.settings.card_title }}
                  </h3>
                  {% if block.settings.show_description %}
                    <p class="category-card-description category-card-description--small" style="color: {{ block.settings.description_color }};">
                      {{ block.settings.card_description }}
                    </p>
                  {% endif %}
                </div>

                {% if block.settings.show_icon %}
                  <div class="category-card-icon category-card-icon--small">
                    {% if block.settings.icon_image != blank %}
                      <img src="{{ block.settings.icon_image | image_url: width: 60 }}" alt="{{ block.settings.card_title }}">
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            </a>

        {% endcase %}
      {% endfor %}
    </div>

    {% comment %} BOTÓN VER MÁS {% endcomment %}
    {% if section.settings.show_view_all %}
      <div class="category-grid-footer">
        <a
          href="{{ section.settings.view_all_link }}"
          class="category-view-all-btn"
          style="
            background-color: {{ section.settings.button_bg }};
            color: {{ section.settings.button_text_color }};
            border-color: {{ section.settings.button_border_color }};
          "
        >
          {{ section.settings.view_all_text }}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    {% endif %}

  </div>
</div>

<script>
  // Countdown timer
  document.addEventListener('DOMContentLoaded', function() {
    const countdowns = document.querySelectorAll('.category-countdown');

    countdowns.forEach(function(countdown) {
      const endDate = new Date(countdown.dataset.endDate).getTime();

      const updateCountdown = function() {
        const now = new Date().getTime();
        const distance = endDate - now;

        if (distance < 0) {
          countdown.innerHTML = '<div class="countdown-expired">¡Oferta finalizada!</div>';
          return;
        }

        const days = Math.floor(distance / (1000 * 60 * 60 * 24));
        const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));

        const daysEl = countdown.querySelector('[data-days]');
        const hoursEl = countdown.querySelector('[data-hours]');
        const minutesEl = countdown.querySelector('[data-minutes]');

        if (daysEl) daysEl.textContent = String(days).padStart(2, '0');
        if (hoursEl) hoursEl.textContent = String(hours).padStart(2, '0');
        if (minutesEl) minutesEl.textContent = String(minutes).padStart(2, '0');
      };

      updateCountdown();
      setInterval(updateCountdown, 60000); // Actualizar cada minuto
    });
  });
</script>

