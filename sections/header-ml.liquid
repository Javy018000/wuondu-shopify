{{ 'header-ml.css' | asset_url | stylesheet_tag }}

<div class="shopify-section-header-ml">
  {% comment %} Barra de anuncios amarilla {% endcomment %}
  {% if section.settings.show_announcement %}
    <div class="ml-announcement-bar">
      <div class="page-width">
        <p class="ml-announcement-bar__message">
          {% if section.settings.announcement_link != blank %}
            <a href="{{ section.settings.announcement_link }}">
              {{ section.settings.announcement_text }}
            </a>
          {% else %}
            {{ section.settings.announcement_text }}
          {% endif %}
        </p>
      </div>
    </div>
  {% endif %}

  {% comment %} Header principal naranja {% endcomment %}
  <header class="ml-header">
    <div class="page-width">
      <div class="ml-header__inner">
        {% comment %} Logo {% endcomment %}
        <div class="ml-header__logo">
          <a href="{{ routes.root_url }}" class="ml-logo-link">
            {% if section.settings.logo != blank %}
              <img
                src="{{ section.settings.logo | image_url: width: 180 }}"
                alt="{{ shop.name }}"
                width="180"
                height="auto"
                loading="eager"
              >
            {% else %}
              <span class="ml-logo-text">{{ shop.name }}</span>
            {% endif %}
          </a>
        </div>

        {% comment %} Buscador {% endcomment %}
        <div class="ml-header__search">
          <form action="{{ routes.search_url }}" method="get" role="search" class="ml-search-form">
            <input
              type="search"
              name="q"
              class="ml-search-input"
              placeholder="{{ section.settings.search_placeholder }}"
              value="{{ search.terms | escape }}"
            >
            <button type="submit" class="ml-search-button">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.35-4.35"></path>
              </svg>
            </button>
          </form>
        </div>

        {% comment %} Iconos de usuario y carrito {% endcomment %}
        <div class="ml-header__icons">
          {% if shop.customer_accounts_enabled %}
            <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="ml-header-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
              <span class="ml-icon-label">{% if customer %}{{ customer.first_name | default: 'Cuenta' }}{% else %}Ingresa{% endif %}</span>
            </a>
          {% endif %}

          <a href="{{ routes.cart_url }}" class="ml-header-icon ml-cart-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="9" cy="21" r="1"></circle>
              <circle cx="20" cy="21" r="1"></circle>
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
            </svg>
            <span class="ml-icon-label">Carrito</span>
            {% if cart.item_count > 0 %}
              <span class="ml-cart-count">{{ cart.item_count }}</span>
            {% endif %}
          </a>
        </div>
      </div>
    </div>
  </header>

  {% comment %} Barra de navegación {% endcomment %}
  {% if section.settings.menu != blank %}
    <nav class="ml-nav-bar">
      <div class="page-width">
        <ul class="ml-nav-list">
          {% for link in linklists[section.settings.menu].links %}
            <li class="ml-nav-item">
              <a href="{{ link.url }}" class="ml-nav-link{% if link.active %} ml-nav-link--active{% endif %}">
                {{ link.title }}
              </a>
            </li>
          {% endfor %}
        </ul>
      </div>
    </nav>
  {% endif %}
</div>

{% schema %}
{
  "name": "Header ML",
  "settings": [
    {
      "type": "header",
      "content": "Barra de anuncios"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Mostrar barra de anuncios",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Texto del anuncio",
      "default": "Envío gratis en compras superiores a $50.000"
    },
    {
      "type": "url",
      "id": "announcement_link",
      "label": "Enlace del anuncio (opcional)"
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "header",
      "content": "Búsqueda"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Placeholder de búsqueda",
      "default": "Buscar productos, marcas y más..."
    },
    {
      "type": "header",
      "content": "Navegación"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menú de navegación",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
