{{ 'header-ml.css' | asset_url | stylesheet_tag }}

<div class="header-ml">

  {% comment %} --- BARRA SUPERIOR NARANJA (ESTILO AMAZON) --- {% endcomment %}
  <header class="ml-topbar">
    <div class="ml-topbar__inner page-width">

      {% comment %} --- MENÚ HAMBURGUESA --- {% endcomment %}
      <button class="ml-hamburger" aria-label="Menu">
        <svg width="24" height="24" viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>

      {% comment %} --- LOGO --- {% endcomment %}
      <a href="{{ routes.root_url }}" class="ml-logo">
        {% if section.settings.logo != blank %}
          <img src="{{ section.settings.logo | image_url: width: 140 }}" alt="{{ shop.name }}" loading="eager">
        {% else %}
          <span class="ml-logo-text">{{ shop.name }}</span>
        {% endif %}
      </a>

      {% comment %} --- SELECTOR "TODOS" + BUSCADOR --- {% endcomment %}
      <div class="ml-search-container">

        <div class="ml-search-category">
          <select name="category">
            <option value="all">Todos</option>
          </select>
        </div>

        <form action="{{ routes.search_url }}" method="get" role="search" class="ml-search-form">
          <input
            type="search"
            name="q"
            class="ml-search-input"
            placeholder="{{ section.settings.search_placeholder }}"
            value="{{ search.terms | escape }}"
          >
          <button type="submit" class="ml-search-button">
            <svg width="20" height="20" viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.35-4.35"></path>
            </svg>
          </button>
        </form>
      </div>

      {% comment %} --- ICONOS DERECHA (CUENTA - DEVOLUCIONES - CARRITO) --- {% endcomment %}
      <div class="ml-right-icons">

        <a class="ml-account" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">
          <span class="ml-small-text">Hola, {% if customer %}{{ customer.first_name }}{% else %}Identifícate{% endif %}</span>
          <span class="ml-bold-text">Cuenta y Listas</span>
        </a>

        <a class="ml-returns" href="{{ routes.account_url }}">
          <span class="ml-small-text">Devoluciones</span>
          <span class="ml-bold-text">y Pedidos</span>
        </a>

        <a href="{{ routes.cart_url }}" class="ml-cart-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"></path>
          </svg>
          <span class="ml-bold-text">Carrito</span>

          {% if cart.item_count > 0 %}
            <span class="ml-cart-count">{{ cart.item_count }}</span>
          {% endif %}
        </a>

      </div>

    </div>
  </header>

  {% comment %} --- BARRA DE NAVEGACIÓN SECUNDARIA --- {% endcomment %}
  {% if section.settings.menu != blank %}
    <nav class="ml-nav-bar">
      <div class="page-width">
        <ul class="ml-nav-list">
          {% for link in linklists[section.settings.menu].links %}
            <li class="ml-nav-item">
              <a href="{{ link.url }}" class="ml-nav-link{% if link.active %} ml-active{% endif %}">
                {{ link.title }}
              </a>
            </li>
          {% endfor %}
        </ul>
      </div>
    </nav>
  {% endif %}

</div>

{% schema %}
{
  "name": "Header ML",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Placeholder búsqueda",
      "default": "Buscar productos, marcas y más..."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menú navegación",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
