{{ 'hero-slider-ml-enhanced.css' | asset_url | stylesheet_tag }}

<div class="hero-slider-ml-enhanced">
  <div class="hero-slider__wrapper" id="heroSliderML">
    <div class="hero-slider__slides" id="heroSlidesML">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'slide' -%}
            <div class="hero-slide" data-slide-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
              {%- comment -%} Imagen de fondo con efecto parallax {%- endcomment -%}
              <div class="hero-slide__image-wrapper">
                {%- if block.settings.image != blank -%}
                  <img
                    srcset="
                      {{ block.settings.image | image_url: width: 600 }} 600w,
                      {{ block.settings.image | image_url: width: 1200 }} 1200w,
                      {{ block.settings.image | image_url: width: 1800 }} 1800w,
                      {{ block.settings.image | image_url: width: 2400 }} 2400w
                    "
                    sizes="100vw"
                    src="{{ block.settings.image | image_url: width: 1200 }}"
                    alt="{{ block.settings.title | escape }}"
                    class="hero-slide__image"
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  >
                {%- else -%}
                  <div class="hero-slide__image hero-slide__image--gradient"></div>
                {%- endif -%}
              </div>

              {%- comment -%} Overlay oscuro {%- endcomment -%}
              {%- if block.settings.show_overlay -%}
                <div class="hero-slide__overlay" style="opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};"></div>
              {%- endif -%}

              {%- comment -%} Contenido del slide {%- endcomment -%}
              <div class="page-width">
                <div class="hero-slide__content hero-slide__content--{{ block.settings.text_alignment }}">
                  {%- comment -%} Badge opcional {%- endcomment -%}
                  {%- if block.settings.show_badge and block.settings.badge_text != blank -%}
                    <span class="hero-slide__badge hero-slide__badge--{{ block.settings.badge_style }}">
                      {{ block.settings.badge_text }}
                    </span>
                  {%- endif -%}

                  {%- comment -%} Título con animación {%- endcomment -%}
                  {%- if block.settings.title != blank -%}
                    <h2 class="hero-slide__title">{{ block.settings.title }}</h2>
                  {%- endif -%}

                  {%- comment -%} Texto descriptivo {%- endcomment -%}
                  {%- if block.settings.text != blank -%}
                    <p class="hero-slide__text">{{ block.settings.text }}</p>
                  {%- endif -%}

                  {%- comment -%} Botones de acción {%- endcomment -%}
                  {%- if block.settings.button_label != blank or block.settings.button_label_2 != blank -%}
                    <div class="hero-slide__buttons">
                      {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
                        <a href="{{ block.settings.button_link }}" class="hero-button hero-button--primary">
                          {{ block.settings.button_label }}
                          <svg class="hero-button__icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                          </svg>
                        </a>
                      {%- endif -%}

                      {%- comment -%} Botón secundario opcional {%- endcomment -%}
                      {%- if block.settings.button_label_2 != blank and block.settings.button_link_2 != blank -%}
                        <a href="{{ block.settings.button_link_2 }}" class="hero-button hero-button--secondary">
                          {{ block.settings.button_label_2 }}
                        </a>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>
              </div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    {%- comment -%} Controles del slider {%- endcomment -%}
    {%- if section.blocks.size > 1 -%}
      {%- comment -%} Flechas de navegación {%- endcomment -%}
      <button class="hero-slider__arrow hero-slider__arrow--prev" onclick="moveSlide(-1)" aria-label="Slide anterior">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <button class="hero-slider__arrow hero-slider__arrow--next" onclick="moveSlide(1)" aria-label="Siguiente slide">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>

      {%- comment -%} Indicadores (dots) {%- endcomment -%}
      <div class="hero-slider__indicators">
        {%- for block in section.blocks -%}
          <button
            class="hero-slider__dot{% if forloop.first %} hero-slider__dot--active{% endif %}"
            onclick="goToSlide({{ forloop.index0 }})"
            aria-label="Ir al slide {{ forloop.index }}"
            data-slide="{{ forloop.index0 }}"
          ></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  (function() {
    let currentSlide = 0;
    const totalSlides = {{ section.blocks.size }};
    const autoplayInterval = {{ section.settings.autoplay_speed | times: 1000 }};
    let autoplayTimer;
    let isTransitioning = false;

    function updateSlider() {
      if (isTransitioning) return;
      isTransitioning = true;

      const slidesContainer = document.getElementById('heroSlidesML');
      const dots = document.querySelectorAll('.hero-slider__dot');
      const slides = document.querySelectorAll('.hero-slide');

      // Actualizar transformación del slider
      if (slidesContainer) {
        slidesContainer.style.transform = `translateX(-${currentSlide * 100}%)`;
      }

      // Actualizar dots
      dots.forEach((dot, index) => {
        dot.classList.toggle('hero-slider__dot--active', index === currentSlide);
      });

      // Agregar clases de animación al slide actual
      slides.forEach((slide, index) => {
        if (index === currentSlide) {
          slide.classList.add('hero-slide--active');
        } else {
          slide.classList.remove('hero-slide--active');
        }
      });

      setTimeout(() => {
        isTransitioning = false;
      }, 600);
    }

    window.moveSlide = function(direction) {
      if (isTransitioning) return;
      currentSlide = (currentSlide + direction + totalSlides) % totalSlides;
      updateSlider();
      resetAutoplay();
    };

    window.goToSlide = function(index) {
      if (isTransitioning || index === currentSlide) return;
      currentSlide = index;
      updateSlider();
      resetAutoplay();
    };

    function startAutoplay() {
      {% if section.settings.enable_autoplay %}
        autoplayTimer = setInterval(() => {
          moveSlide(1);
        }, autoplayInterval);
      {% endif %}
    }

    function resetAutoplay() {
      {% if section.settings.enable_autoplay %}
        clearInterval(autoplayTimer);
        startAutoplay();
      {% endif %}
    }

    // Inicializar
    document.addEventListener('DOMContentLoaded', function() {
      // Activar el primer slide
      const firstSlide = document.querySelector('.hero-slide');
      if (firstSlide) {
        firstSlide.classList.add('hero-slide--active');
      }

      // Iniciar autoplay
      startAutoplay();

      // Pausar en hover
      const slider = document.getElementById('heroSliderML');
      if (slider) {
        slider.addEventListener('mouseenter', () => {
          clearInterval(autoplayTimer);
        });

        slider.addEventListener('mouseleave', () => {
          startAutoplay();
        });
      }

      // Soporte para gestos táctiles
      let touchStartX = 0;
      let touchEndX = 0;

      if (slider) {
        slider.addEventListener('touchstart', (e) => {
          touchStartX = e.changedTouches[0].screenX;
        });

        slider.addEventListener('touchend', (e) => {
          touchEndX = e.changedTouches[0].screenX;
          handleSwipe();
        });
      }

      function handleSwipe() {
        if (touchEndX < touchStartX - 50) {
          moveSlide(1); // Swipe left
        }
        if (touchEndX > touchStartX + 50) {
          moveSlide(-1); // Swipe right
        }
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Hero Slider ML",
  "class": "hero-slider-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Activar reproducción automática",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Velocidad de reproducción",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen de fondo"
        },
        {
          "type": "checkbox",
          "id": "show_overlay",
          "label": "Mostrar capa oscura",
          "default": true
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 80,
          "step": 10,
          "unit": "%",
          "label": "Opacidad de la capa",
          "default": 50
        },
        {
          "type": "header",
          "content": "Badge"
        },
        {
          "type": "checkbox",
          "id": "show_badge",
          "label": "Mostrar badge",
          "default": false
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Texto del badge",
          "default": "NUEVO"
        },
        {
          "type": "select",
          "id": "badge_style",
          "label": "Estilo del badge",
          "options": [
            { "value": "new", "label": "Nuevo (Azul)" },
            { "value": "sale", "label": "Oferta (Naranja)" },
            { "value": "hot", "label": "Hot (Rojo)" }
          ],
          "default": "new"
        },
        {
          "type": "header",
          "content": "Contenido"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Descubre nuestras ofertas"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Descripción",
          "default": "Las mejores ofertas en productos de calidad para ti"
        },
        {
          "type": "select",
          "id": "text_alignment",
          "label": "Alineación del texto",
          "options": [
            { "value": "left", "label": "Izquierda" },
            { "value": "center", "label": "Centro" },
            { "value": "right", "label": "Derecha" }
          ],
          "default": "left"
        },
        {
          "type": "header",
          "content": "Botón principal"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Texto del botón",
          "default": "Ver ofertas"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Enlace del botón"
        },
        {
          "type": "header",
          "content": "Botón secundario (opcional)"
        },
        {
          "type": "text",
          "id": "button_label_2",
          "label": "Texto del botón secundario"
        },
        {
          "type": "url",
          "id": "button_link_2",
          "label": "Enlace del botón secundario"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Slider ML",
      "blocks": [
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
