{{ 'comparison-table-ml.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Esta sección puede usar metafields del producto para mostrar características específicas.
  Si no hay metafields, usa los bloques de la sección como fallback.

  Metafield esperado: product.metafields.custom.comparison_features
  Tipo: list.metaobject_reference (con metaobject de tipo 'comparison_feature')
  Campos del metaobject:
  - feature_name (single_line_text_field)
  - us_has_feature (boolean)
  - others_have_feature (boolean)
{%- endcomment -%}

{%- assign product_features = product.metafields.custom.comparison_features.value -%}
{%- assign has_product_features = false -%}
{%- if product_features != blank and product_features.size > 0 -%}
  {%- assign has_product_features = true -%}
{%- endif -%}

<div class="comparison-ml section-{{ section.id }}-padding">
  <div class="page-width">

    {%- if section.settings.heading != blank -%}
      <h2 class="comparison-ml__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subtitle != blank -%}
      <p class="comparison-ml__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}

    <div class="comparison-ml__table-wrapper">
      <table class="comparison-ml__table">
        <thead>
          <tr>
            <th class="comparison-ml__header-empty"></th>
            <th class="comparison-ml__header-us">
              {{ section.settings.column_us_title | default: "Nosotros" }}
            </th>
            <th class="comparison-ml__header-others">
              {{ section.settings.column_others_title | default: "Otros" }}
            </th>
          </tr>
        </thead>
        <tbody>
          {%- if has_product_features -%}
            {%- comment -%} Mostrar características del producto desde metafields {%- endcomment -%}
            {%- for feature in product_features -%}
              <tr>
                <td class="comparison-ml__feature-name">{{ feature.feature_name.value }}</td>
                <td class="comparison-ml__cell-us">
                  {%- if feature.us_has_feature.value == true -%}
                    <svg class="comparison-ml__check" width="24" height="24" viewBox="0 0 24 24" fill="none">
                      <circle cx="12" cy="12" r="10" fill="#FFC107"/>
                      <path d="M9 12l2 2 4-4" stroke="#000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  {%- else -%}
                    <svg class="comparison-ml__cross" width="24" height="24" viewBox="0 0 24 24">
                      <path d="M18 6L6 18M6 6l12 12" stroke="#999" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                  {%- endif -%}
                </td>
                <td class="comparison-ml__cell-others">
                  {%- if feature.others_have_feature.value == true -%}
                    <svg class="comparison-ml__check" width="24" height="24" viewBox="0 0 24 24" fill="none">
                      <circle cx="12" cy="12" r="10" fill="#e0e0e0"/>
                      <path d="M9 12l2 2 4-4" stroke="#666" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  {%- else -%}
                    <svg class="comparison-ml__cross" width="24" height="24" viewBox="0 0 24 24">
                      <path d="M18 6L6 18M6 6l12 12" stroke="#999" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                  {%- endif -%}
                </td>
              </tr>
            {%- endfor -%}
          {%- else -%}
            {%- comment -%} Mostrar características de los bloques de la sección (fallback) {%- endcomment -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'feature' -%}
                <tr {{ block.shopify_attributes }}>
                  <td class="comparison-ml__feature-name">{{ block.settings.feature_name }}</td>
                  <td class="comparison-ml__cell-us">
                    {%- if block.settings.us_has_feature -%}
                      <svg class="comparison-ml__check" width="24" height="24" viewBox="0 0 24 24" fill="none">
                        <circle cx="12" cy="12" r="10" fill="#FFC107"/>
                        <path d="M9 12l2 2 4-4" stroke="#000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    {%- else -%}
                      <svg class="comparison-ml__cross" width="24" height="24" viewBox="0 0 24 24">
                        <path d="M18 6L6 18M6 6l12 12" stroke="#999" stroke-width="2" stroke-linecap="round"/>
                      </svg>
                    {%- endif -%}
                  </td>
                  <td class="comparison-ml__cell-others">
                    {%- if block.settings.others_have_feature -%}
                      <svg class="comparison-ml__check" width="24" height="24" viewBox="0 0 24 24" fill="none">
                        <circle cx="12" cy="12" r="10" fill="#e0e0e0"/>
                        <path d="M9 12l2 2 4-4" stroke="#666" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    {%- else -%}
                      <svg class="comparison-ml__cross" width="24" height="24" viewBox="0 0 24 24">
                        <path d="M18 6L6 18M6 6l12 12" stroke="#999" stroke-width="2" stroke-linecap="round"/>
                      </svg>
                    {%- endif -%}
                  </td>
                </tr>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </tbody>
      </table>
    </div>

  </div>
</div>

