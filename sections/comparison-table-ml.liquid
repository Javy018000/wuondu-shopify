{{ 'comparison-table-ml.css' | asset_url | stylesheet_tag }}

<div class="comparison-ml section-{{ section.id }}-padding">
  <div class="page-width">

    {%- if section.settings.heading != blank -%}
      <h2 class="comparison-ml__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subtitle != blank -%}
      <p class="comparison-ml__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}

    <div class="comparison-ml__table-wrapper">
      <table class="comparison-ml__table">
        <thead>
          <tr>
            <th class="comparison-ml__header-empty"></th>
            <th class="comparison-ml__header-us">
              {{ section.settings.column_us_title | default: "Nosotros" }}
            </th>
            <th class="comparison-ml__header-others">
              {{ section.settings.column_others_title | default: "Otros" }}
            </th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            {%- if block.type == 'feature' -%}
              <tr {{ block.shopify_attributes }}>
                <td class="comparison-ml__feature-name">{{ block.settings.feature_name }}</td>
                <td class="comparison-ml__cell-us">
                  {%- if block.settings.us_has_feature -%}
                    <svg class="comparison-ml__check" width="24" height="24" viewBox="0 0 24 24" fill="none">
                      <circle cx="12" cy="12" r="10" fill="#FFC107"/>
                      <path d="M9 12l2 2 4-4" stroke="#000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  {%- else -%}
                    <svg class="comparison-ml__cross" width="24" height="24" viewBox="0 0 24 24">
                      <path d="M18 6L6 18M6 6l12 12" stroke="#999" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                  {%- endif -%}
                </td>
                <td class="comparison-ml__cell-others">
                  {%- if block.settings.others_have_feature -%}
                    <svg class="comparison-ml__check" width="24" height="24" viewBox="0 0 24 24" fill="none">
                      <circle cx="12" cy="12" r="10" fill="#e0e0e0"/>
                      <path d="M9 12l2 2 4-4" stroke="#666" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  {%- else -%}
                    <svg class="comparison-ml__cross" width="24" height="24" viewBox="0 0 24 24">
                      <path d="M18 6L6 18M6 6l12 12" stroke="#999" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                  {%- endif -%}
                </td>
              </tr>
            {%- endif -%}
          {%- endfor -%}
        </tbody>
      </table>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Comparación ML",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Nosotros vs Otros"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Compara y descubre por qué somos la mejor opción"
    },
    {
      "type": "text",
      "id": "column_us_title",
      "label": "Título columna nuestra",
      "default": "Control de Gatillo"
    },
    {
      "type": "text",
      "id": "column_others_title",
      "label": "Título columna otros",
      "default": "Otros"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaciado superior",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaciado inferior",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Característica",
      "settings": [
        {
          "type": "text",
          "id": "feature_name",
          "label": "Nombre de la característica",
          "default": "Gatillos mecánicos de alta precisión"
        },
        {
          "type": "checkbox",
          "id": "us_has_feature",
          "label": "Nosotros tenemos esta característica",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "others_have_feature",
          "label": "Otros tienen esta característica",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparación ML",
      "settings": {
        "heading": "Nosotros vs Otros",
        "subtitle": "El Control Gamepad Móvil M-06 te ofrece por completo la experiencia. Es como tener una consola en la palma de tus manos.",
        "column_us_title": "CONTROL DE GATILLO",
        "column_others_title": "Otros"
      },
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "feature_name": "Gatillos mecánicos de alta precisión",
            "us_has_feature": true,
            "others_have_feature": false
          }
        },
        {
          "type": "feature",
          "settings": {
            "feature_name": "Diseño ergonómico y liga gamepad",
            "us_has_feature": true,
            "others_have_feature": false
          }
        },
        {
          "type": "feature",
          "settings": {
            "feature_name": "Material ABS premium",
            "us_has_feature": true,
            "others_have_feature": false
          }
        },
        {
          "type": "feature",
          "settings": {
            "feature_name": "Compatible con todos los smartphones",
            "us_has_feature": true,
            "others_have_feature": false
          }
        },
        {
          "type": "feature",
          "settings": {
            "feature_name": "Sin batería, sin recargas de sílica",
            "us_has_feature": true,
            "others_have_feature": false
          }
        }
      ]
    }
  ]
}
{% endschema %}
