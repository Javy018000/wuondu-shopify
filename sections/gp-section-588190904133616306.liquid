    <title>Sección Logos de Medios Premium</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Libre+Baskerville:wght@400;700&family=Cormorant+Garamond:wght@300;400;600&display=swap');
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
            background-color: #FAFAFA;
        }
        
        .media-section {
            background-color: #FFFFFF;
            padding: 5px 0;
            overflow: hidden;
            position: relative;
            border-top: 1px solid #E5E5E5;
            border-bottom: 1px solid #E5E5E5;
        }
        
        .media-header {
            text-align: center;
            margin-bottom: 5px;
        }
        
        .media-header h3 {
            font-size: 11px;
            color: #666666;
            text-transform: uppercase;
            letter-spacing: 3px;
            font-weight: 400;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
        }
        
        .marquee-container {
            position: relative;
            width: 100%;
            overflow: hidden;
            /* Gradient para fade en los bordes */
            mask-image: linear-gradient(to right, 
                transparent, 
                black 10%, 
                black 90%, 
                transparent
            );
            -webkit-mask-image: linear-gradient(to right, 
                transparent, 
                black 10%, 
                black 90%, 
                transparent
            );
        }
        
        .marquee-track {
            display: flex;
            animation: marquee 40s linear infinite;
            width: fit-content;
        }
        
        @keyframes marquee {
            0% {
                transform: translateX(0);
            }
            100% {
                transform: translateX(-50%);
            }
        }
        
        .logo-wrapper {
            flex: 0 0 auto;
            margin: 0 80px;
            display: flex;
            align-items: center;
            justify-content: center;
            min-width: 200px;
        }
        
        .logo-text {
            font-size: 24px;
            font-weight: 400;
            color: #2C2C2C;
            opacity: 0.7;
            transition: all 0.4s ease;
            white-space: nowrap;
            letter-spacing: 0;
        }
        
        /* Estilos específicos para cada logo - Todos en tonos grises/negros */
        .logo-ft {
            font-family: Georgia, serif;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 4px;
            font-size: 26px;
        }
        
        .logo-wsj {
            font-family: 'Playfair Display', serif;
            font-weight: 700;
            letter-spacing: -1px;
            font-size: 28px;
        }
        
        .logo-economist {
            font-family: Georgia, serif;
            font-weight: 400;
            font-size: 26px;
            color: #E3120B;
            opacity: 0.8;
        }
        
        .logo-bloomberg {
            font-family: 'Helvetica Neue', Arial, sans-serif;
            font-weight: 700;
            letter-spacing: -1px;
            font-size: 24px;
        }
        
        .logo-fortune {
            font-family: Georgia, serif;
            text-transform: uppercase;
            font-weight: 400;
            letter-spacing: 3px;
            font-size: 22px;
        }
        
        .logo-robb {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 300;
            letter-spacing: 2px;
            font-size: 24px;
            text-transform: uppercase;
        }
        
        .logo-monocle {
            font-family: 'Helvetica Neue', Arial, sans-serif;
            font-weight: 600;
            letter-spacing: 4px;
            text-transform: uppercase;
            font-size: 20px;
        }
        
        .logo-hbr {
            font-family: Georgia, serif;
            font-weight: 400;
            font-style: italic;
            font-size: 24px;
        }
        
        .logo-vogue {
            font-family: 'Libre Baskerville', serif;
            text-transform: uppercase;
            letter-spacing: 5px;
            font-weight: 400;
            font-size: 22px;
        }
        
        .logo-gq {
            font-family: 'Helvetica Neue', Arial, sans-serif;
            font-weight: 800;
            letter-spacing: -2px;
            font-size: 32px;
        }
        
        /* Hover effect sutil */
        .marquee-container:hover .marquee-track {
            animation-play-state: paused;
        }
        
        .logo-wrapper:hover .logo-text {
            opacity: 1;
            transform: translateY(-2px);
        }
        
        /* Responsive */
        @media (max-width: 768px) {
            .media-section {
                padding: 5px 0;
            }
            
            .media-header h3 {
                font-size: 10px;
                letter-spacing: 2px;
            }
            
            .logo-text {
                font-size: 18px;
            }
            
            .logo-wrapper {
                margin: 0 50px;
                min-width: 150px;
            }
            
            .marquee-track {
                animation-duration: 25s;
            }
            
            .logo-ft { font-size: 20px; }
            .logo-wsj { font-size: 22px; }
            .logo-economist { font-size: 20px; }
            .logo-bloomberg { font-size: 18px; }
            .logo-fortune { font-size: 16px; }
            .logo-robb { font-size: 18px; }
            .logo-monocle { font-size: 14px; }
            .logo-hbr { font-size: 18px; }
            .logo-vogue { font-size: 16px; }
            .logo-gq { font-size: 24px; }
        }
    </style>
</head>
