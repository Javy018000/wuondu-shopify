{{ 'product-card-ml.css' | asset_url | stylesheet_tag }}
{{ 'theme-ml-visual-enhancements.css' | asset_url | stylesheet_tag }}

<!-- Separador decorativo -->
<div class="section-wave-divider section-wave-divider--white section-wave-divider--bottom"></div>

<div class="featured-collection-ml section-{{ section.id }}-padding section-featured-products-ml">
  <div class="page-width">
    {%- comment -%} Encabezado de la secci�n {%- endcomment -%}
    {%- if section.settings.title != blank -%}
      <div class="featured-collection-ml__header">
        <h2 class="featured-collection-ml__title">{{ section.settings.title }}</h2>
        {%- if section.settings.show_view_all and section.settings.collection != blank -%}
          <a href="{{ collections[section.settings.collection].url }}" class="featured-collection-ml__view-all">
            Ver todos
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} Grid de productos {%- endcomment -%}
    {%- liquid
      assign collection_to_show = collections[section.settings.collection]
      assign products_to_show = section.settings.products_to_show | at_most: 12
    -%}

    {%- if collection_to_show != blank and collection_to_show.products_count > 0 -%}
      <div class="products-grid-ml">
        {%- for product in collection_to_show.products limit: products_to_show -%}
          <div class="products-grid-ml__item">
            {% render 'card-product-ml',
              card_product: product,
              section_id: section.id,
              show_secondary_image: section.settings.show_secondary_image,
              show_discount_badge: section.settings.show_discount_badge,
              show_free_shipping_badge: section.settings.show_free_shipping_badge,
              free_shipping_threshold: section.settings.free_shipping_threshold,
              lazy_load: true
            %}
          </div>
        {%- endfor -%}
      </div>

      {%- comment -%} Bot�n "Ver todos" en mobile {%- endcomment -%}
      {%- if section.settings.show_view_all and section.settings.collection != blank -%}
        <div class="featured-collection-ml__view-all-mobile">
          <a href="{{ collections[section.settings.collection].url }}" class="featured-collection-ml__view-all-button">
            Ver todos los productos
          </a>
        </div>
      {%- endif -%}

    {%- else -%}
      {%- comment -%} Placeholder cuando no hay productos {%- endcomment -%}
      <div class="products-grid-ml">
        {%- for i in (1..products_to_show) -%}
          <div class="products-grid-ml__item">
            {% render 'card-product-ml', section_id: section.id %}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  .featured-collection-ml {
    padding: 40px 0;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .featured-collection-ml__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }

  .featured-collection-ml__title {
    font-size: 26px;
    font-weight: 400;
    color: #333;
    margin: 0;
  }

  .featured-collection-ml__view-all {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: #3483FA;
    font-size: 14px;
    font-weight: 400;
    text-decoration: none;
    transition: gap 0.2s ease;
  }

  .featured-collection-ml__view-all:hover {
    gap: 8px;
  }

  .featured-collection-ml__view-all svg {
    flex-shrink: 0;
  }

  .featured-collection-ml__view-all-mobile {
    display: none;
    margin-top: 24px;
    text-align: center;
  }

  .featured-collection-ml__view-all-button {
    display: inline-block;
    padding: 12px 32px;
    background: #fff;
    color: #3483FA;
    border: 1px solid #3483FA;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .featured-collection-ml__view-all-button:hover {
    background: #3483FA;
    color: #fff;
  }

  @media (max-width: 749px) {
    .featured-collection-ml {
      padding: 32px 0;
    }

    .featured-collection-ml__header {
      margin-bottom: 20px;
    }

    .featured-collection-ml__title {
      font-size: 22px;
    }

    .featured-collection-ml__view-all {
      display: none;
    }

    .featured-collection-ml__view-all-mobile {
      display: block;
    }
  }
</style>

