{{ 'header-ml.css' | asset_url | stylesheet_tag }}
{{ 'theme-ml-custom.css' | asset_url | stylesheet_tag }}

{% comment %} Cargar cart drawer y búsqueda predictiva {% endcomment %}
<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>

<a href="#main-content" class="header-ml-skip-to-content">
  {{ 'accessibility.skip_to_text' | t }}
</a>

<div class="header-ml-wrapper">
  {% comment %} ===== BARRA DE ANUNCIOS (OPCIONAL) ===== {% endcomment %}
  {% if section.settings.show_announcement and section.settings.announcement_text != blank %}
    <div class="header-ml-announcement">
      <div class="header-ml-announcement__container">
        {% if section.settings.announcement_link != blank %}
          <a href="{{ section.settings.announcement_link }}" class="header-ml-announcement__text">
            {{ section.settings.announcement_text }}
          </a>
        {% else %}
          <p class="header-ml-announcement__text">{{ section.settings.announcement_text }}</p>
        {% endif %}
      </div>
    </div>
  {% endif %}

  {% comment %} ===== BARRA PRINCIPAL - NARANJA ===== {% endcomment %}
  <div class="header-ml-primary">
    <div class="header-ml-primary__container">
      {% comment %} MENÚ HAMBURGUESA MÓVIL {% endcomment %}
      <button
        class="header-ml-mobile-toggle"
        onclick="openMobileMenu()"
        aria-label="{{ 'general.menu' | t }}"
      >
        <svg class="header-ml-mobile-toggle__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>

      {% comment %} LOGO {% endcomment %}
      <div class="header-ml-logo">
        <a href="{{ routes.root_url }}" class="header-ml-logo__text">
          {%- if section.settings.logo != blank -%}
            <img
              src="{{ section.settings.logo | image_url: width: 200 }}"
              alt="{{ shop.name }}"
              width="200"
              height="40"
            >
          {%- else -%}
            {{ shop.name }}
          {%- endif -%}
        </a>
      </div>

      {% comment %} BUSCADOR {% endcomment %}
      <div class="header-ml-search">
        <predictive-search data-loading-text="{{ 'accessibility.loading' | t }}">
          <form action="{{ routes.search_url }}" method="get" role="search" class="header-ml-search__form">
            <input
              type="search"
              name="q"
              class="header-ml-search__input"
              placeholder="{{ section.settings.search_placeholder | default: 'Buscar productos, marcas y más...' }}"
              value="{{ search.terms | escape }}"
              role="combobox"
              aria-expanded="false"
              aria-owns="predictive-search-results-ml"
              aria-controls="predictive-search-results-ml"
              aria-haspopup="listbox"
              aria-autocomplete="list"
              autocorrect="off"
              autocomplete="off"
              autocapitalize="off"
              spellcheck="false"
            >
            <input type="hidden" name="options[prefix]" value="last">
            <button type="submit" class="header-ml-search__button" aria-label="{{ 'general.search.search' | t }}">
              <svg class="header-ml-search__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
              </svg>
            </button>

            {% comment %} RESULTADOS PREDICTIVOS {% endcomment %}
            <div
              id="predictive-search-results-ml"
              class="header-ml-predictive"
              role="listbox"
              tabindex="-1"
            ></div>
          </form>
        </predictive-search>
      </div>

      {% comment %} ACCIONES DE USUARIO {% endcomment %}
      <div class="header-ml-actions">
        {% if section.settings.show_account_links %}
          {% if shop.customer_accounts_enabled %}
            {% if customer %}
              <a href="{{ routes.account_url }}" class="header-ml-action header-ml-hidden-mobile">
                <svg class="header-ml-action__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
                <span class="header-ml-action__text">{{ customer.first_name | default: 'Mi cuenta' }}</span>
              </a>
            {% else %}
              <a href="{{ routes.account_login_url }}" class="header-ml-action header-ml-hidden-mobile">
                <svg class="header-ml-action__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/>
                </svg>
                <span class="header-ml-action__text">Ingresar</span>
              </a>

              {% if section.settings.show_register_link %}
                <a href="{{ routes.account_register_url }}" class="header-ml-action header-ml-hidden-mobile">
                  <svg class="header-ml-action__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
                  </svg>
                  <span class="header-ml-action__text">Crear cuenta</span>
                </a>
              {% endif %}
            {% endif %}
          {% endif %}
        {% endif %}

        {% if section.settings.show_orders_link and customer %}
          <a href="{{ routes.account_url }}#orders" class="header-ml-action header-ml-hidden-mobile">
            <svg class="header-ml-action__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
            </svg>
            <span class="header-ml-action__text">Mis compras</span>
          </a>
        {% endif %}

        {% comment %} CARRITO {% endcomment %}
        <a href="{{ routes.cart_url }}" class="header-ml-action header-ml-cart" id="cart-icon-bubble">
          <svg class="header-ml-action__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
          </svg>
          <span class="header-ml-action__text header-ml-hidden-mobile">Carrito</span>
          {% if cart.item_count > 0 %}
            <span class="header-ml-cart__count">{{ cart.item_count }}</span>
          {% endif %}
        </a>
      </div>
    </div>
  </div>

  {% comment %} ===== BARRA SECUNDARIA - NAVEGACIÓN ===== {% endcomment %}
  <div class="header-ml-secondary">
    <div class="header-ml-secondary__container">
      {% comment %} BOTÓN DE CATEGORÍAS {% endcomment %}
      {% if section.settings.show_categories_menu %}
        <button
          class="header-ml-categories-toggle"
          onclick="toggleMegaMenu()"
          aria-expanded="false"
          aria-controls="header-ml-megamenu"
        >
          <svg class="header-ml-categories-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          {{ section.settings.categories_text | default: 'Categorías' }}
        </button>
      {% endif %}

      {% comment %} NAVEGACIÓN ADICIONAL {% endcomment %}
      {% if section.settings.menu != blank %}
        <ul class="header-ml-nav">
          {%- for link in linklists[section.settings.menu].links -%}
            <li class="header-ml-nav__item">
              <a
                href="{{ link.url }}"
                class="header-ml-nav__link{% if link.current %} header-ml-nav__link--highlight{% endif %}"
              >
                {{ link.title }}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      {% endif %}
    </div>
  </div>

  {% comment %} ===== MEGA MENÚ ===== {% endcomment %}
  {% if section.settings.show_categories_menu %}
    <div id="header-ml-megamenu" class="header-ml-megamenu" aria-hidden="true">
      <div class="header-ml-megamenu__container">
        {% if section.settings.megamenu != blank %}
          {%- for link in linklists[section.settings.megamenu].links -%}
            <div class="header-ml-megamenu__column">
              <a href="{{ link.url }}" class="header-ml-megamenu__title">
                {{ link.title }}
              </a>

              {%- if link.links != blank -%}
                <ul class="header-ml-megamenu__list">
                  {%- for child_link in link.links -%}
                    <li>
                      <a href="{{ child_link.url }}" class="header-ml-megamenu__link">
                        {{ child_link.title }}
                      </a>

                      {%- if child_link.links != blank -%}
                        <ul class="header-ml-megamenu__list" style="margin-left: 12px; margin-top: 8px;">
                          {%- for grandchild_link in child_link.links -%}
                            <li>
                              <a href="{{ grandchild_link.url }}" class="header-ml-megamenu__link">
                                {{ grandchild_link.title }}
                              </a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          {%- endfor -%}
        {% endif %}
      </div>
    </div>

    {% comment %} Overlay para cerrar el mega menú {% endcomment %}
    <div id="header-ml-megamenu-overlay" class="header-ml-overlay" onclick="closeMegaMenu()"></div>
  {% endif %}
</div>

{% comment %} ===== MENÚ MÓVIL ===== {% endcomment %}
<div id="header-ml-mobile-menu" class="header-ml-mobile-menu">
  <div class="header-ml-mobile-menu__header">
    <span class="header-ml-mobile-menu__title">Menú</span>
    <button class="header-ml-mobile-menu__close" onclick="closeMobileMenu()" aria-label="{{ 'accessibility.close' | t }}">
      <svg class="header-ml-mobile-menu__close-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  {% comment %} Enlaces de usuario en móvil {% endcomment %}
  {% if shop.customer_accounts_enabled %}
    <div class="header-ml-mobile-menu__user">
      <div class="header-ml-mobile-menu__user-links">
        {% if customer %}
          <a href="{{ routes.account_url }}" class="header-ml-mobile-menu__user-link">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
            {{ customer.first_name | default: 'Mi cuenta' }}
          </a>
          <a href="{{ routes.account_url }}#orders" class="header-ml-mobile-menu__user-link">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
            </svg>
            Mis compras
          </a>
        {% else %}
          <a href="{{ routes.account_login_url }}" class="header-ml-mobile-menu__user-link">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/>
            </svg>
            Ingresar
          </a>
          <a href="{{ routes.account_register_url }}" class="header-ml-mobile-menu__user-link">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
            </svg>
            Crear cuenta
          </a>
        {% endif %}
      </div>
    </div>
  {% endif %}

  {% comment %} Categorías en móvil {% endcomment %}
  <ul class="header-ml-mobile-menu__nav">
    {% if section.settings.megamenu != blank %}
      {%- for link in linklists[section.settings.megamenu].links -%}
        <li class="header-ml-mobile-menu__item">
          <a href="{{ link.url }}" class="header-ml-mobile-menu__link">
            {{ link.title }}
            {%- if link.links != blank -%}
              <svg class="header-ml-mobile-menu__arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24" onclick="toggleMobileSubmenu(event, this)">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            {%- endif -%}
          </a>

          {%- if link.links != blank -%}
            <ul class="header-ml-mobile-menu__submenu">
              {%- for child_link in link.links -%}
                <li>
                  <a href="{{ child_link.url }}" class="header-ml-mobile-menu__submenu-link">
                    {{ child_link.title }}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </li>
      {%- endfor -%}
    {% endif %}

    {% comment %} Enlaces adicionales del menú secundario {% endcomment %}
    {% if section.settings.menu != blank %}
      {%- for link in linklists[section.settings.menu].links -%}
        <li class="header-ml-mobile-menu__item">
          <a href="{{ link.url }}" class="header-ml-mobile-menu__link">
            {{ link.title }}
          </a>
        </li>
      {%- endfor -%}
    {% endif %}
  </ul>
</div>

<div id="header-ml-mobile-overlay" class="header-ml-mobile-menu__overlay" onclick="closeMobileMenu()"></div>

{% comment %} ===== CART DRAWER NATIVO ===== {% endcomment %}
{% render 'cart-drawer' %}

<script>
  // ===== MEGA MENÚ =====
  function toggleMegaMenu() {
    const menu = document.getElementById('header-ml-megamenu');
    const overlay = document.getElementById('header-ml-megamenu-overlay');
    const button = document.querySelector('.header-ml-categories-toggle');

    if (menu && overlay && button) {
      const isOpen = menu.classList.contains('header-ml-megamenu--open');

      if (isOpen) {
        closeMegaMenu();
      } else {
        menu.classList.add('header-ml-megamenu--open');
        overlay.classList.add('header-ml-overlay--visible');
        button.setAttribute('aria-expanded', 'true');
        menu.setAttribute('aria-hidden', 'false');
      }
    }
  }

  function closeMegaMenu() {
    const menu = document.getElementById('header-ml-megamenu');
    const overlay = document.getElementById('header-ml-megamenu-overlay');
    const button = document.querySelector('.header-ml-categories-toggle');

    if (menu && overlay && button) {
      menu.classList.remove('header-ml-megamenu--open');
      overlay.classList.remove('header-ml-overlay--visible');
      button.setAttribute('aria-expanded', 'false');
      menu.setAttribute('aria-hidden', 'true');
    }
  }

  // Cerrar con tecla ESC
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      closeMegaMenu();
      closeMobileMenu();
    }
  });

  // ===== MENÚ MÓVIL =====
  function openMobileMenu() {
    const menu = document.getElementById('header-ml-mobile-menu');
    const overlay = document.getElementById('header-ml-mobile-overlay');

    if (menu && overlay) {
      menu.classList.add('header-ml-mobile-menu--open');
      overlay.classList.add('header-ml-mobile-menu__overlay--visible');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeMobileMenu() {
    const menu = document.getElementById('header-ml-mobile-menu');
    const overlay = document.getElementById('header-ml-mobile-overlay');

    if (menu && overlay) {
      menu.classList.remove('header-ml-mobile-menu--open');
      overlay.classList.remove('header-ml-mobile-menu__overlay--visible');
      document.body.style.overflow = '';
    }
  }

  function toggleMobileSubmenu(event, arrow) {
    event.preventDefault();
    event.stopPropagation();

    const submenu = arrow.closest('.header-ml-mobile-menu__item').querySelector('.header-ml-mobile-menu__submenu');

    if (submenu) {
      submenu.classList.toggle('header-ml-mobile-menu__submenu--open');
      arrow.classList.toggle('header-ml-mobile-menu__arrow--rotated');
    }
  }

  // ===== BÚSQUEDA PREDICTIVA =====
  class PredictiveSearch extends HTMLElement {
    constructor() {
      super();
      this.input = this.querySelector('input[type="search"]');
      this.resultsContainer = this.querySelector('#predictive-search-results-ml');
      this.debounceTimer = null;

      if (this.input) {
        this.input.addEventListener('input', this.debounce(this.handleInput.bind(this), 300));
        this.input.addEventListener('focus', this.handleFocus.bind(this));
      }

      // Cerrar resultados al hacer clic fuera
      document.addEventListener('click', (e) => {
        if (!this.contains(e.target)) {
          this.closeResults();
        }
      });
    }

    debounce(func, wait) {
      return (...args) => {
        clearTimeout(this.debounceTimer);
        this.debounceTimer = setTimeout(() => func.apply(this, args), wait);
      };
    }

    handleInput(event) {
      const searchTerm = event.target.value.trim();

      if (searchTerm.length < 2) {
        this.closeResults();
        return;
      }

      this.getSearchResults(searchTerm);
    }

    handleFocus(event) {
      const searchTerm = event.target.value.trim();
      if (searchTerm.length >= 2) {
        this.getSearchResults(searchTerm);
      }
    }

    getSearchResults(searchTerm) {
      this.showLoading();

      fetch(`/search/suggest.json?q=${encodeURIComponent(searchTerm)}&resources[type]=product&resources[limit]=6`)
        .then(response => response.json())
        .then(data => {
          this.renderResults(data.resources.results.products, searchTerm);
        })
        .catch(error => {
          console.error('Error fetching search results:', error);
          this.closeResults();
        });
    }

    showLoading() {
      if (this.resultsContainer) {
        this.resultsContainer.innerHTML = '<div class="header-ml-predictive__loading">Buscando...</div>';
        this.resultsContainer.classList.add('header-ml-predictive--visible');
      }
    }

    renderResults(products, searchTerm) {
      if (!this.resultsContainer) return;

      if (!products || products.length === 0) {
        this.resultsContainer.innerHTML = '<div class="header-ml-predictive__empty">No se encontraron productos</div>';
        return;
      }

      let html = '';
      products.forEach(product => {
        const price = Shopify.formatMoney(product.price, "{{amount_no_decimals}}");
        const image = product.image || '';

        html += `
          <a href="${product.url}" class="header-ml-predictive__product">
            ${image ? `<img src="${image}" alt="${product.title}" class="header-ml-predictive__image" loading="lazy">` : ''}
            <div class="header-ml-predictive__info">
              <div class="header-ml-predictive__title">${product.title}</div>
              <div class="header-ml-predictive__price">$${price}</div>
            </div>
          </a>
        `;
      });

      html += `
        <div class="header-ml-predictive__footer">
          <a href="/search?q=${encodeURIComponent(searchTerm)}" class="header-ml-predictive__view-all">
            Ver todos los resultados →
          </a>
        </div>
      `;

      this.resultsContainer.innerHTML = html;
      this.resultsContainer.classList.add('header-ml-predictive--visible');
    }

    closeResults() {
      if (this.resultsContainer) {
        this.resultsContainer.classList.remove('header-ml-predictive--visible');
      }
    }
  }

  customElements.define('predictive-search', PredictiveSearch);

  // ===== ACTUALIZAR CONTADOR DEL CARRITO =====
  document.addEventListener('DOMContentLoaded', function() {
    // Escuchar eventos del carrito
    document.addEventListener('cart:updated', function(event) {
      updateCartCount();
    });
  });

  function updateCartCount() {
    fetch('/cart.js')
      .then(response => response.json())
      .then(cart => {
        const cartIcon = document.getElementById('cart-icon-bubble');
        const existingCount = cartIcon.querySelector('.header-ml-cart__count');

        if (cart.item_count > 0) {
          if (existingCount) {
            existingCount.textContent = cart.item_count;
          } else {
            const countBadge = document.createElement('span');
            countBadge.className = 'header-ml-cart__count';
            countBadge.textContent = cart.item_count;
            cartIcon.appendChild(countBadge);
          }
        } else {
          if (existingCount) {
            existingCount.remove();
          }
        }
      })
      .catch(error => console.error('Error updating cart count:', error));
  }
</script>

{% schema %}
{
  "name": "Header ML",
  "settings": [
    {
      "type": "header",
      "content": "Barra de anuncios"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Mostrar barra de anuncios",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Texto del anuncio",
      "default": "Envío gratis en compras superiores a $50.000"
    },
    {
      "type": "url",
      "id": "announcement_link",
      "label": "Enlace del anuncio (opcional)"
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Imagen del logo"
    },
    {
      "type": "header",
      "content": "Búsqueda"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Placeholder de búsqueda",
      "default": "Buscar productos, marcas y más..."
    },
    {
      "type": "header",
      "content": "Cuenta de usuario"
    },
    {
      "type": "checkbox",
      "id": "show_account_links",
      "label": "Mostrar enlaces de cuenta",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_register_link",
      "label": "Mostrar enlace 'Crear cuenta'",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_orders_link",
      "label": "Mostrar enlace 'Mis compras'",
      "default": true
    },
    {
      "type": "header",
      "content": "Navegación"
    },
    {
      "type": "checkbox",
      "id": "show_categories_menu",
      "label": "Mostrar menú de categorías",
      "default": true
    },
    {
      "type": "text",
      "id": "categories_text",
      "label": "Texto del botón de categorías",
      "default": "Categorías"
    },
    {
      "type": "link_list",
      "id": "megamenu",
      "label": "Menú de categorías (Mega menú)",
      "info": "Este menú se mostrará en el mega menú desplegable. Soporta hasta 3 niveles."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menú de navegación adicional",
      "info": "Enlaces adicionales que aparecen en la barra secundaria (Ofertas, Ayuda, etc.)"
    }
  ]
}
{% endschema %}
