            );
            -webkit-mask-image: linear-gradient(to right, 
                transparent, 
                black 10%, 
                black 90%, 
                transparent
            );
        }
        
        .marquee-track {
            display: flex;
            animation: marquee 40s linear infinite;
            width: fit-content;
