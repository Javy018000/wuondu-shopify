            font-size: 11px;
            color: #666666;
            text-transform: uppercase;
            letter-spacing: 3px;
            font-weight: 400;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
        }
        
        .marquee-container {
            position: relative;
            width: 100%;
            overflow: hidden;
            /* Gradient para fade en los bordes */
            mask-image: linear-gradient(to right, 
