{{ 'promo-banners-ml.css' | asset_url | stylesheet_tag }}

<div class="promo-banners-ml section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="promo-banners-ml__container">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'banner' -%}
            <a
              href="{{ block.settings.link }}"
              class="promo-banner promo-banner--{{ block.settings.style }}"
              {{ block.shopify_attributes }}
            >
              <div class="promo-banner__content">
                {%- if block.settings.show_icon -%}
                  <div class="promo-banner__icon">
                    {%- case block.settings.icon -%}
                      {%- when 'shipping' -%}
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <rect x="1" y="3" width="15" height="13"></rect>
                          <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                          <circle cx="5.5" cy="18.5" r="2.5"></circle>
                          <circle cx="18.5" cy="18.5" r="2.5"></circle>
                        </svg>
                      {%- when 'discount' -%}
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <circle cx="12" cy="12" r="10"></circle>
                          <line x1="12" y1="8" x2="12" y2="12"></line>
                          <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                      {%- when 'fire' -%}
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path>
                        </svg>
                      {%- when 'gift' -%}
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <polyline points="20 12 20 22 4 22 4 12"></polyline>
                          <rect x="2" y="7" width="20" height="5"></rect>
                          <line x1="12" y1="22" x2="12" y2="7"></line>
                          <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
                          <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
                        </svg>
                      {%- when 'tag' -%}
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                          <line x1="7" y1="7" x2="7.01" y2="7"></line>
                        </svg>
                      {%- when 'star' -%}
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                        </svg>
                    {%- endcase -%}
                  </div>
                {%- endif -%}

                <div class="promo-banner__text">
                  {%- if block.settings.title != blank -%}
                    <h3 class="promo-banner__title">{{ block.settings.title }}</h3>
                  {%- endif -%}
                  {%- if block.settings.subtitle != blank -%}
                    <p class="promo-banner__subtitle">{{ block.settings.subtitle }}</p>
                  {%- endif -%}
                </div>

                {%- if block.settings.show_arrow -%}
                  <div class="promo-banner__arrow">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                  </div>
                {%- endif -%}
              </div>

              {%- if block.settings.show_coupon_border -%}
                <div class="promo-banner__coupon-edges">
                  <div class="promo-banner__coupon-edge promo-banner__coupon-edge--left"></div>
                  <div class="promo-banner__coupon-edge promo-banner__coupon-edge--right"></div>
                </div>
              {%- endif -%}
            </a>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
</style>

{% schema %}
{
  "name": "Banners Promocionales ML",
  "tag": "section",
  "class": "promo-banners-ml-section",
  "settings": [
    {
      "type": "header",
      "content": "Espaciado de la sección"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaciado superior",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaciado inferior",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner Promocional",
      "settings": [
        {
          "type": "select",
          "id": "style",
          "label": "Estilo del banner",
          "options": [
            { "value": "primary", "label": "Primario (Naranja)" },
            { "value": "success", "label": "Éxito (Verde)" },
            { "value": "info", "label": "Info (Azul)" },
            { "value": "warning", "label": "Advertencia (Amarillo)" },
            { "value": "danger", "label": "Urgente (Rojo)" }
          ],
          "default": "primary"
        },
        {
          "type": "header",
          "content": "Icono"
        },
        {
          "type": "checkbox",
          "id": "show_icon",
          "label": "Mostrar icono",
          "default": true
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Tipo de icono",
          "options": [
            { "value": "shipping", "label": "Envío" },
            { "value": "discount", "label": "Descuento" },
            { "value": "fire", "label": "Fuego (Hot)" },
            { "value": "gift", "label": "Regalo" },
            { "value": "tag", "label": "Etiqueta" },
            { "value": "star", "label": "Estrella" }
          ],
          "default": "shipping"
        },
        {
          "type": "header",
          "content": "Contenido"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Envío gratis en compras superiores a $50.000"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtítulo (opcional)",
          "info": "Texto secundario más pequeño"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace",
          "info": "Página a la que redirige al hacer clic"
        },
        {
          "type": "header",
          "content": "Opciones de diseño"
        },
        {
          "type": "checkbox",
          "id": "show_arrow",
          "label": "Mostrar flecha",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_coupon_border",
          "label": "Mostrar borde tipo cupón",
          "default": true,
          "info": "Bordes con semicírculos en los extremos"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Banners Promocionales ML",
      "blocks": [
        {
          "type": "banner",
          "settings": {
            "style": "success",
            "show_icon": true,
            "icon": "shipping",
            "title": "Envío gratis en compras superiores a $50.000",
            "show_arrow": true,
            "show_coupon_border": true
          }
        },
        {
          "type": "banner",
          "settings": {
            "style": "danger",
            "show_icon": true,
            "icon": "fire",
            "title": "20% OFF en toda la tienda - Solo por hoy",
            "subtitle": "Usa el cupón: SUPER20",
            "show_arrow": true,
            "show_coupon_border": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
