{{ 'header-wuondu-enhanced.css' | asset_url | stylesheet_tag }}

<div class="header-wuondu-enhanced">

  {% comment %} === OVERLAY PARA CERRAR DRAWER === {% endcomment %}
  <div class="wuondu-drawer-overlay" id="wuonduDrawerOverlay"></div>

  {% comment %} === MENÚ LATERAL (DRAWER) === {% endcomment %}
  <aside class="wuondu-drawer" id="wuonduDrawer">
    <div class="wuondu-drawer-header">
      <h2 class="wuondu-drawer-title">{{ section.settings.drawer_title }}</h2>
      <button class="wuondu-drawer-close" id="wuonduDrawerClose" aria-label="Cerrar menú">
        <svg width="24" height="24" viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="wuondu-drawer-content">
      {% comment %} Usuario logueado {% endcomment %}
      <div class="wuondu-drawer-user">
        {% if customer %}
          <p class="wuondu-drawer-greeting">Hola, <strong>{{ customer.first_name }}</strong></p>
        {% else %}
          <a href="{{ routes.account_login_url }}" class="wuondu-drawer-login-btn">
            Iniciar sesión
          </a>
        {% endif %}
      </div>

      {% comment %} Categorías principales {% endcomment %}
      {% if section.settings.drawer_menu != blank %}
        <nav class="wuondu-drawer-nav">
          <h3 class="wuondu-drawer-section-title">{{ section.settings.categories_title }}</h3>
          <ul class="wuondu-drawer-menu">
            {% for link in linklists[section.settings.drawer_menu].links %}
              <li class="wuondu-drawer-menu-item">
                <a href="{{ link.url }}" class="wuondu-drawer-link">
                  {{ link.title }}
                  {% if link.links.size > 0 %}
                    <svg width="16" height="16" viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2">
                      <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                  {% endif %}
                </a>
                {% if link.links.size > 0 %}
                  <ul class="wuondu-drawer-submenu">
                    {% for child_link in link.links %}
                      <li>
                        <a href="{{ child_link.url }}" class="wuondu-drawer-sublink">
                          {{ child_link.title }}
                        </a>
                      </li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        </nav>
      {% endif %}

      {% comment %} Enlaces rápidos {% endcomment %}
      <div class="wuondu-drawer-quick-links">
        <h3 class="wuondu-drawer-section-title">{{ section.settings.quick_links_title }}</h3>
        <ul class="wuondu-drawer-quick-list">
          <li><a href="{{ routes.account_url }}">Mi cuenta</a></li>
          <li><a href="{{ routes.account_url }}">Mis pedidos</a></li>
          {% if section.settings.show_wishlist %}
            <li><a href="{{ section.settings.wishlist_url }}">Lista de deseos</a></li>
          {% endif %}
          <li><a href="{{ routes.cart_url }}">Carrito</a></li>
        </ul>
      </div>

      {% comment %} Información adicional {% endcomment %}
      {% if section.settings.show_drawer_info %}
        <div class="wuondu-drawer-info">
          <p>{{ section.settings.drawer_info_text }}</p>
        </div>
      {% endif %}
    </div>
  </aside>

  {% comment %} === BARRA SUPERIOR === {% endcomment %}
  <header class="wuondu-topbar" style="background-color: {{ section.settings.topbar_bg_color }};">
    <div class="wuondu-topbar__inner page-width">

      {% comment %} MENÚ HAMBURGUESA {% endcomment %}
      {% if section.settings.show_hamburger %}
        <button class="wuondu-hamburger" id="wuonduHamburger" aria-label="{{ section.settings.hamburger_label }}">
          <svg width="24" height="24" viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2">
            <line x1="3" y1="6" x2="21" y2="6"/>
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
          {% if section.settings.show_hamburger_text %}
            <span class="wuondu-hamburger-text">{{ section.settings.hamburger_text }}</span>
          {% endif %}
        </button>
      {% endif %}

      {% comment %} LOGO {% endcomment %}
      <a href="{{ routes.root_url }}" class="wuondu-logo">
        {% if section.settings.logo != blank %}
          <img
            src="{{ section.settings.logo | image_url: width: section.settings.logo_width }}"
            alt="{{ shop.name }}"
            loading="eager"
            style="height: {{ section.settings.logo_height }}px;"
          >
        {% else %}
          <span class="wuondu-logo-text" style="color: {{ section.settings.logo_text_color }};">
            {{ section.settings.logo_text | default: shop.name }}
          </span>
        {% endif %}
      </a>

      {% comment %} BUSCADOR CON SELECTOR DE CATEGORÍA MEJORADO {% endcomment %}
      {% if section.settings.show_search %}
        <div class="wuondu-search-container">

          {% if section.settings.show_category_selector %}
            <div class="wuondu-search-category">
              <select
                name="category"
                id="wuonduCategorySelect"
                style="background-color: {{ section.settings.category_bg_color }};"
              >
                <option value="" data-url="{{ routes.search_url }}">{{ section.settings.category_all_text }}</option>

                {% comment %} Colecciones dinámicas {% endcomment %}
                {% if section.settings.use_collections %}
                  {% for collection in collections limit: 10 %}
                    {% if collection.all_products_count > 0 %}
                      <option value="{{ collection.handle }}" data-url="{{ collection.url }}">
                        {{ collection.title }}
                      </option>
                    {% endif %}
                  {% endfor %}
                {% endif %}

                {% comment %} Categorías personalizadas de bloques {% endcomment %}
                {% for block in section.blocks %}
                  {% if block.type == 'category' %}
                    <option
                      value="{{ block.settings.category_value }}"
                      data-url="{{ block.settings.category_url }}"
                      data-type="{{ block.settings.search_type }}"
                    >
                      {{ block.settings.category_name }}
                    </option>
                  {% endif %}
                {% endfor %}
              </select>
            </div>
          {% endif %}

          <form action="{{ routes.search_url }}" method="get" role="search" class="wuondu-search-form" id="wuonduSearchForm">
            <input
              type="search"
              name="q"
              class="wuondu-search-input"
              id="wuonduSearchInput"
              placeholder="{{ section.settings.search_placeholder }}"
              value="{{ search.terms | escape }}"
              autocomplete="off"
            >
            <input type="hidden" name="type" id="wuonduSearchType" value="">
            <input type="hidden" name="options[prefix]" value="last">

            <button type="submit" class="wuondu-search-button" style="background-color: {{ section.settings.search_button_color }};">
              <svg width="20" height="20" viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.35-4.35"></path>
              </svg>
            </button>
          </form>
        </div>
      {% endif %}

      {% comment %} ICONOS DERECHA {% endcomment %}
      <div class="wuondu-right-icons">

        {% comment %} CUENTA Y LISTAS {% endcomment %}
        {% if section.settings.show_account %}
          <a
            class="wuondu-account"
            href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
            style="color: {{ section.settings.topbar_text_color }};"
          >
            <span class="wuondu-small-text">
              {{ section.settings.account_greeting }}{% if customer %} {{ customer.first_name }}{% else %} {{ section.settings.account_login_text }}{% endif %}
            </span>
            <span class="wuondu-bold-text">{{ section.settings.account_text }}</span>
          </a>
        {% endif %}

        {% comment %} DEVOLUCIONES Y PEDIDOS {% endcomment %}
        {% if section.settings.show_returns %}
          <a
            class="wuondu-returns"
            href="{% if section.settings.returns_link != blank %}{{ section.settings.returns_link }}{% else %}{{ routes.account_url }}{% endif %}"
            style="color: {{ section.settings.topbar_text_color }};"
          >
            <span class="wuondu-small-text">{{ section.settings.returns_small_text }}</span>
            <span class="wuondu-bold-text">{{ section.settings.returns_bold_text }}</span>
          </a>
        {% endif %}

        {% comment %} CARRITO {% endcomment %}
        {% if section.settings.show_cart %}
          <a
            href="{{ routes.cart_url }}"
            class="wuondu-cart-icon"
            style="color: {{ section.settings.topbar_text_color }};"
          >
            <svg width="28" height="28" viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2">
              <circle cx="9" cy="21" r="1"></circle>
              <circle cx="20" cy="21" r="1"></circle>
              <path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"></path>
            </svg>
            <span class="wuondu-bold-text">{{ section.settings.cart_text }}</span>

            {% if cart.item_count > 0 %}
              <span class="wuondu-cart-count" style="background-color: {{ section.settings.cart_count_bg }}; color: {{ section.settings.cart_count_color }};">
                {{ cart.item_count }}
              </span>
            {% endif %}
          </a>
        {% endif %}

      </div>

    </div>
  </header>

  {% comment %} === BARRA DE NAVEGACIÓN SECUNDARIA === {% endcomment %}
  {% if section.settings.show_nav_bar and section.settings.menu != blank %}
    <nav class="wuondu-nav-bar" style="background-color: {{ section.settings.navbar_bg_color }}; padding: {{ section.settings.navbar_padding }}px 0;">
      <div class="page-width">
        <ul class="wuondu-nav-list">
          {% for link in linklists[section.settings.menu].links %}
            <li class="wuondu-nav-item">
              <a
                href="{{ link.url }}"
                class="wuondu-nav-link{% if link.active %} wuondu-active{% endif %}"
                style="color: {{ section.settings.navbar_text_color }}; font-size: {{ section.settings.navbar_font_size }}px;"
              >
                {{ link.title }}
              </a>
            </li>
          {% endfor %}
        </ul>
      </div>
    </nav>
  {% endif %}

</div>

<script>
  (function() {
    const hamburger = document.getElementById('wuonduHamburger');
    const drawer = document.getElementById('wuonduDrawer');
    const drawerClose = document.getElementById('wuonduDrawerClose');
    const overlay = document.getElementById('wuonduDrawerOverlay');
    const categorySelect = document.getElementById('wuonduCategorySelect');
    const searchForm = document.getElementById('wuonduSearchForm');
    const searchInput = document.getElementById('wuonduSearchInput');
    const searchType = document.getElementById('wuonduSearchType');

    // Abrir drawer
    if (hamburger) {
      hamburger.addEventListener('click', function() {
        drawer.classList.add('wuondu-drawer--open');
        overlay.classList.add('wuondu-drawer-overlay--visible');
        document.body.style.overflow = 'hidden';
      });
    }

    // Cerrar drawer
    function closeDrawer() {
      drawer.classList.remove('wuondu-drawer--open');
      overlay.classList.remove('wuondu-drawer-overlay--visible');
      document.body.style.overflow = '';
    }

    if (drawerClose) {
      drawerClose.addEventListener('click', closeDrawer);
    }

    if (overlay) {
      overlay.addEventListener('click', closeDrawer);
    }

    // Cerrar con tecla ESC
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && drawer.classList.contains('wuondu-drawer--open')) {
        closeDrawer();
      }
    });

    // Manejar búsqueda por categoría
    if (categorySelect && searchForm) {
      categorySelect.addEventListener('change', function() {
        const selectedOption = this.options[this.selectedIndex];
        const searchTypeValue = selectedOption.getAttribute('data-type');

        if (searchTypeValue) {
          searchType.value = searchTypeValue;
        } else {
          searchType.value = '';
        }
      });

      // Al enviar el formulario, redirigir si hay URL específica
      searchForm.addEventListener('submit', function(e) {
        const selectedOption = categorySelect.options[categorySelect.selectedIndex];
        const categoryUrl = selectedOption.getAttribute('data-url');
        const searchValue = searchInput.value.trim();

        if (categoryUrl && categoryUrl !== '{{ routes.search_url }}' && searchValue) {
          e.preventDefault();
          // Redirigir a la colección con parámetro de búsqueda
          window.location.href = categoryUrl + '?q=' + encodeURIComponent(searchValue);
        }
      });
    }

    // Expandir/colapsar submenús en drawer
    const drawerLinks = document.querySelectorAll('.wuondu-drawer-link');
    drawerLinks.forEach(function(link) {
      const submenu = link.nextElementSibling;
      if (submenu && submenu.classList.contains('wuondu-drawer-submenu')) {
        link.addEventListener('click', function(e) {
          e.preventDefault();
          submenu.classList.toggle('wuondu-drawer-submenu--open');
          link.classList.toggle('wuondu-drawer-link--active');
        });
      }
    });
  })();
</script>

