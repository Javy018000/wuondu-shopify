/* ===============================================
   PREGUNTAS FRECUENTES MERCADO LIBRE
   =============================================== */

.faq-ml {
  position: relative;
  padding: 60px 0;
}

/* Estilos de fondo (igual que comparaciones) */
.section-bg-white {
  background: #FFFFFF;
}

.section-bg-gray {
  background: linear-gradient(180deg, #FAFAFA 0%, #F5F5F5 100%);
}

.section-bg-orange-light {
  background: linear-gradient(180deg, #FFF9F5 0%, #FFE8DC 100%);
}

/* Glow decorativo */
.faq-ml::before {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 200px;
  background: radial-gradient(circle at 50% 100%, rgba(255, 102, 0, 0.06) 0%, transparent 70%);
  pointer-events: none;
}

.section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top | default: 60 }}px;
  padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
}

.faq-ml__heading {
  text-align: center;
  font-size: 36px;
  font-weight: 700;
  color: #1a1a1a;
  margin: 0 0 16px 0;
  line-height: 1.2;
  position: relative;
}

.faq-ml__subtitle {
  text-align: center;
  font-size: 17px;
  color: #666;
  margin: 0 auto 50px auto;
  max-width: 700px;
  line-height: 1.6;
}

.faq-ml__accordion {
  max-width: 800px;
  margin: 0 auto;
}

.faq-ml__item {
  background: #fff;
  border: 2px solid #e5e5e5;
  border-radius: 12px;
  margin-bottom: 16px;
  overflow: hidden;
  transition: all 0.3s ease;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

.faq-ml__item:hover {
  border-color: #FF6600;
  box-shadow: 0 4px 16px rgba(255, 102, 0, 0.12);
  transform: translateY(-2px);
}

.faq-ml__item.is-active {
  border-color: #FF6600;
  box-shadow: 0 8px 24px rgba(255, 102, 0, 0.15);
}

.faq-ml__question {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 24px;
  background: #fff;
  border: none;
  cursor: pointer;
  text-align: left;
  font-size: 16px;
  font-weight: 500;
  color: #333;
  transition: background 0.2s;
}

.faq-ml__question:hover {
  background: #f5f5f5;
}

.faq-ml__item.is-active .faq-ml__question {
  background: linear-gradient(135deg, #FFF9F5 0%, #FFE8DC 100%);
  color: #FF6600;
  font-weight: 600;
}

.faq-ml__question-text {
  flex: 1;
  padding-right: 16px;
}

.faq-ml__icon {
  flex-shrink: 0;
  color: #666;
  transition: transform 0.3s ease, color 0.3s ease;
}

.faq-ml__item.is-active .faq-ml__icon {
  color: #FF6600;
  transform: rotate(180deg);
}

.faq-ml__icon-vertical {
  transition: opacity 0.3s ease;
}

.faq-ml__item.is-active .faq-ml__icon-vertical {
  opacity: 0;
}

.faq-ml__answer {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
}

.faq-ml__answer-content {
  padding: 0 24px 20px 24px;
  font-size: 15px;
  line-height: 1.6;
  color: #666;
}

.faq-ml__answer-content p {
  margin: 0 0 12px 0;
}

.faq-ml__answer-content p:last-child {
  margin-bottom: 0;
}

/* ===============================================
   RESPONSIVE - TABLET
   =============================================== */
@media screen and (max-width: 989px) {
  .faq-ml__heading {
    font-size: 28px;
  }

  .faq-ml__subtitle {
    font-size: 15px;
  }

  .faq-ml__question {
    padding: 16px 20px;
    font-size: 15px;
  }

  .faq-ml__answer-content {
    padding: 0 20px 16px 20px;
    font-size: 14px;
  }
}

/* ===============================================
   RESPONSIVE - M�VIL
   =============================================== */
@media screen and (max-width: 749px) {
  .faq-ml__heading {
    font-size: 24px;
  }

  .faq-ml__subtitle {
    font-size: 14px;
    margin-bottom: 30px;
  }

  .faq-ml__question {
    padding: 14px 16px;
    font-size: 14px;
  }

  .faq-ml__answer-content {
    padding: 0 16px 14px 16px;
    font-size: 13px;
  }

  .faq-ml__icon {
    width: 18px;
    height: 18px;
  }
}

/* ===============================================
   ACCESIBILIDAD
   =============================================== */
.faq-ml__question:focus-visible {
  outline: 2px solid #FF6600;
  outline-offset: -2px;
}

@media (prefers-reduced-motion: reduce) {
  .faq-ml__item,
  .faq-ml__question,
  .faq-ml__icon,
  .faq-ml__icon-vertical,
  .faq-ml__answer {
    transition-duration: 0.01ms !important;
  }
}
