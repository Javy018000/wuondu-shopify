/* ===============================================
   PRODUCTO MERCADO LIBRE - ESTILOS
   =============================================== */

/* Variables CSS para fácil personalización */
:root {
  --ml-color-primary: #3483fa;
  --ml-color-primary-dark: #2968c8;
  --ml-color-success: #00a650;
  --ml-color-warning: #ff6600;
  --ml-color-text: #333;
  --ml-color-text-light: #666;
  --ml-color-text-lighter: #999;
  --ml-color-border: #e5e5e5;
  --ml-color-bg-light: #f5f5f5;
  --ml-color-bg-primary-light: #e8f1fd;
  --ml-border-radius: 6px;
  --ml-transition: all 0.2s ease;
}

/* ===============================================
   BREADCRUMBS
   =============================================== */
.breadcrumbs-ml {
  padding: 12px 0;
  margin-bottom: 16px;
}

.breadcrumbs-ml__list {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  list-style: none;
  margin: 0;
  padding: 0;
}

.breadcrumbs-ml__item {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
}

.breadcrumbs-ml__link {
  color: var(--ml-color-primary);
  text-decoration: none;
  transition: var(--ml-transition);
}

.breadcrumbs-ml__link:hover {
  text-decoration: underline;
}

.breadcrumbs-ml__separator {
  color: var(--ml-color-text-light);
  user-select: none;
}

.breadcrumbs-ml__current {
  color: var(--ml-color-text);
}

/* ===============================================
   ESPACIADO DE SECCIÓN
   =============================================== */
.section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top | default: 36 }}px;
  padding-bottom: {{ section.settings.padding_bottom | default: 36 }}px;
}

/* ===============================================
   CARRUSEL DE LOGOS DE MEDIOS ANIMADO
   =============================================== */
.product-ml__media-strip {
  background-color: var(--ml-color-bg-light);
  border-top: 1px solid var(--ml-color-border);
  border-bottom: 1px solid var(--ml-color-border);
  padding: 20px 0;
  overflow: hidden;
  margin-bottom: 40px;
}

.product-ml__media-label {
  text-align: center;
  font-size: 14px;
  color: var(--ml-color-text-light);
  margin-bottom: 15px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.product-ml__media-carousel {
  overflow: hidden;
  position: relative;
  width: 100%;
}

.product-ml__media-track {
  display: flex;
  gap: 60px;
  animation: scroll-logos 30s linear infinite;
  width: fit-content;
}

.product-ml__media-item {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 150px;
}

.product-ml__media-item img {
  max-width: 120px;
  height: auto;
  opacity: 0.6;
  transition: opacity 0.3s ease;
  filter: grayscale(100%);
}

.product-ml__media-item:hover img {
  opacity: 1;
  filter: grayscale(0%);
}

.product-ml__media-text {
  font-size: 16px;
  font-weight: 600;
  color: var(--ml-color-text);
  opacity: 0.6;
}

/* Animación de scroll infinito */
@keyframes scroll-logos {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-50%);
  }
}

/* Pausar animación al hover */
.product-ml__media-carousel:hover .product-ml__media-track {
  animation-play-state: paused;
}

/* ===============================================
   LAYOUT PRINCIPAL DEL PRODUCTO
   =============================================== */
.product-ml__container {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  margin-top: 40px;
}

/* ===============================================
   GALERÍA DE IMÁGENES
   =============================================== */
.product-ml__gallery {
  position: sticky;
  top: 20px;
  height: fit-content;
}

.product-ml__main-image {
  background: #fff;
  border-radius: var(--ml-border-radius);
  overflow: hidden;
  margin-bottom: 20px;
  border: 1px solid var(--ml-color-border);
  width: 100%;
  padding-bottom: 100%; /* Crea un cuadrado perfecto */
  position: relative;
  height: 0;
}

.product-ml__main-image img {
  position: absolute !important;
  top: 0 !important;
  left: 0 !important;
  width: 100% !important;
  height: 100% !important;
  object-fit: cover !important;
  object-position: center !important;
  transition: transform 0.3s ease;
  display: block;
}

.product-ml__main-image:hover img {
  transform: scale(1.05);
}

.product-ml__thumbnails {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(70px, 1fr));
  gap: 10px;
}

.product-ml__thumbnail {
  background: #fff;
  border: 2px solid var(--ml-color-border);
  border-radius: var(--ml-border-radius);
  cursor: pointer;
  padding: 8px;
  transition: var(--ml-transition);
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.product-ml__thumbnail:hover,
.product-ml__thumbnail.active {
  border-color: var(--ml-color-primary);
}

.product-ml__thumbnail img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center;
  border-radius: 4px;
}

/* ===============================================
   INFORMACIÓN DEL PRODUCTO
   =============================================== */
.product-ml__info {
  background: #fff;
}

.product-ml__badge {
  display: inline-block;
  background: var(--ml-color-warning);
  color: #fff;
  padding: 4px 12px;
  border-radius: 4px;
  font-size: 12px;
  font-weight: 600;
  margin-bottom: 12px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.product-ml__title {
  font-size: 28px;
  font-weight: 400;
  color: var(--ml-color-text);
  margin: 0 0 16px 0;
  line-height: 1.3;
}

.product-ml__vendor {
  font-size: 14px;
  color: var(--ml-color-text-light);
  margin-bottom: 12px;
}

.product-ml__vendor-label {
  margin-right: 6px;
}

.product-ml__vendor-link {
  color: var(--ml-color-primary);
  text-decoration: none;
  font-weight: 500;
  transition: var(--ml-transition);
}

.product-ml__vendor-link:hover {
  text-decoration: underline;
}

/* ===============================================
   RATING Y META INFORMACIÓN
   =============================================== */
.product-ml__meta {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 20px;
  padding-bottom: 20px;
  border-bottom: 1px solid var(--ml-color-border);
}

.product-ml__rating {
  display: flex;
  align-items: center;
  gap: 8px;
}

.product-ml__stars {
  display: flex;
  gap: 2px;
}

.product-ml__star {
  width: 16px;
  height: 16px;
}

.product-ml__rating-count {
  font-size: 13px;
  color: var(--ml-color-text-light);
}

.product-ml__sold {
  font-size: 13px;
  color: var(--ml-color-text-light);
  padding-left: 16px;
  border-left: 1px solid var(--ml-color-border);
}

/* ===============================================
   PRECIO
   =============================================== */
.product-ml__price-wrapper {
  margin-bottom: 32px;
}

.product-ml__price-old {
  font-size: 14px;
  color: var(--ml-color-text-lighter);
  margin-bottom: 6px;
}

.product-ml__price-old-label {
  margin-right: 6px;
}

.product-ml__price-old-amount {
  text-decoration: line-through;
}

.product-ml__price-current {
  display: flex;
  align-items: baseline;
  gap: 12px;
  margin-bottom: 8px;
}

.product-ml__price-amount {
  font-size: 36px;
  font-weight: 300;
  color: var(--ml-color-text);
}

.product-ml__discount-badge {
  background: var(--ml-color-success);
  color: #fff;
  padding: 4px 8px;
  border-radius: 4px;
  font-size: 14px;
  font-weight: 600;
}

.product-ml__installments {
  font-size: 16px;
  color: var(--ml-color-text);
}

.product-ml__installments strong {
  font-weight: 600;
}

.product-ml__installment-amount {
  color: var(--ml-color-success);
  font-weight: 500;
}

/* ===============================================
   VARIANTES
   =============================================== */
.product-ml__variants {
  margin-bottom: 24px;
}

.product-ml__variant-group {
  margin-bottom: 20px;
}

.product-ml__variant-label {
  display: block;
  font-size: 14px;
  font-weight: 600;
  color: var(--ml-color-text);
  margin-bottom: 10px;
}

.product-ml__variant-options {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.product-ml__variant-input {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}

.product-ml__variant-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 60px;
  padding: 10px 16px;
  border: 1px solid var(--ml-color-border);
  border-radius: var(--ml-border-radius);
  background: #fff;
  color: var(--ml-color-text);
  font-size: 14px;
  cursor: pointer;
  transition: var(--ml-transition);
  user-select: none;
}

.product-ml__variant-button:hover {
  border-color: var(--ml-color-primary);
}

.product-ml__variant-input:checked + .product-ml__variant-button {
  border-color: var(--ml-color-primary);
  background: var(--ml-color-bg-primary-light);
  color: var(--ml-color-primary);
  font-weight: 600;
}

/* ===============================================
   CANTIDAD Y BOTÓN DE COMPRA
   =============================================== */
.product-ml__quantity-wrapper {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 24px;
  flex-wrap: wrap;
}

.product-ml__quantity-label {
  font-size: 14px;
  font-weight: 600;
  color: var(--ml-color-text);
}

.product-ml__quantity {
  display: flex;
  align-items: center;
  border: 1px solid var(--ml-color-border);
  border-radius: var(--ml-border-radius);
  overflow: hidden;
}

.product-ml__quantity-btn {
  width: 40px;
  height: 40px;
  background: #fff;
  border: none;
  color: var(--ml-color-primary);
  font-size: 20px;
  cursor: pointer;
  transition: background 0.2s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.product-ml__quantity-btn:hover:not(:disabled) {
  background: var(--ml-color-bg-light);
}

.product-ml__quantity-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.product-ml__quantity-input {
  width: 60px;
  height: 40px;
  border: none;
  border-left: 1px solid var(--ml-color-border);
  border-right: 1px solid var(--ml-color-border);
  text-align: center;
  font-size: 16px;
  font-weight: 500;
  color: var(--ml-color-text);
}

.product-ml__quantity-input:focus {
  outline: none;
}

/* Remove spinner arrows */
.product-ml__quantity-input::-webkit-inner-spin-button,
.product-ml__quantity-input::-webkit-outer-spin-button {
  -webkit-appearance: none;
  margin: 0;
}

.product-ml__quantity-input[type="number"] {
  -moz-appearance: textfield;
  appearance: textfield;
}

.product-ml__stock {
  font-size: 13px;
  color: var(--ml-color-text-light);
}

.product-ml__actions {
  width: 100%;
}

.product-ml__buy-button {
  width: 100%;
  background: var(--ml-color-primary);
  color: #fff;
  border: none;
  padding: 16px 24px;
  border-radius: var(--ml-border-radius);
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  transition: var(--ml-transition);
}

.product-ml__buy-button:hover:not(:disabled) {
  background: var(--ml-color-primary-dark);
  transform: translateY(-1px);
  box-shadow: 0 4px 8px rgba(52, 131, 250, 0.3);
}

.product-ml__buy-button:active:not(:disabled) {
  transform: translateY(0);
}

.product-ml__buy-button:disabled {
  background: #ccc;
  cursor: not-allowed;
}

/* ===============================================
   ENVÍO Y GARANTÍA
   =============================================== */
.product-ml__shipping {
  background: var(--ml-color-bg-light);
  border-radius: var(--ml-border-radius);
  padding: 20px;
  margin: 24px 0;
}

.product-ml__shipping-item {
  display: flex;
  gap: 12px;
  padding: 12px 0;
}

.product-ml__shipping-item:first-child {
  padding-top: 0;
}

.product-ml__shipping-item:not(:last-child) {
  border-bottom: 1px solid var(--ml-color-border);
}

.product-ml__shipping-item svg {
  flex-shrink: 0;
  color: var(--ml-color-success);
  margin-top: 2px;
}

.product-ml__shipping-text strong {
  display: block;
  font-size: 14px;
  color: var(--ml-color-text);
  margin-bottom: 4px;
}

.product-ml__shipping-text p {
  font-size: 13px;
  color: var(--ml-color-text-light);
  margin: 0;
}

/* ===============================================
   DESCRIPCIÓN
   =============================================== */
.product-ml__description {
  margin-top: 32px;
  padding-top: 32px;
  border-top: 1px solid var(--ml-color-border);
}

.product-ml__description-title {
  font-size: 20px;
  font-weight: 600;
  color: var(--ml-color-text);
  margin: 0 0 16px 0;
}

.product-ml__description-content {
  font-size: 15px;
  line-height: 1.6;
  color: var(--ml-color-text-light);
}

.product-ml__description-content p {
  margin-bottom: 12px;
}

.product-ml__description-content ul,
.product-ml__description-content ol {
  margin-left: 20px;
  margin-bottom: 12px;
}

.product-ml__description-content li {
  margin-bottom: 6px;
}

/* ===============================================
   UTILIDADES
   =============================================== */
.page-width {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
}

/* Placeholder */
.placeholder-svg {
  width: 100%;
  height: 100%;
  background: var(--ml-color-bg-light);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===============================================
   RESPONSIVE - TABLET
   =============================================== */
@media screen and (max-width: 989px) {
  .product-ml__container {
    grid-template-columns: 1fr;
    gap: 30px;
  }

  .product-ml__gallery {
    position: static;
  }

  .product-ml__title {
    font-size: 24px;
  }

  .product-ml__price-amount {
    font-size: 28px;
  }

  .product-ml__media-track {
    gap: 40px;
  }

  .product-ml__media-item {
    min-width: 120px;
  }
}

/* ===============================================
   RESPONSIVE - MÓVIL
   =============================================== */
@media screen and (max-width: 749px) {
  .product-ml__container {
    gap: 20px;
  }

  .product-ml__main-image {
    padding: 15px;
  }

  .product-ml__title {
    font-size: 20px;
  }

  .product-ml__price-amount {
    font-size: 24px;
  }

  .product-ml__thumbnails {
    grid-template-columns: repeat(auto-fill, minmax(60px, 1fr));
  }

  .product-ml__thumbnail {
    padding: 6px;
  }

  .product-ml__meta {
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .product-ml__sold {
    border-left: none;
    padding-left: 0;
  }

  .product-ml__quantity-wrapper {
    flex-wrap: wrap;
  }

  .product-ml__media-track {
    gap: 30px;
  }

  .product-ml__media-item {
    min-width: 100px;
  }

  .product-ml__media-item img {
    max-width: 100px;
  }

  .breadcrumbs-ml {
    padding: 8px 0;
    margin-bottom: 12px;
  }

  .product-ml__variant-button {
    padding: 8px 12px;
    font-size: 13px;
    min-width: 50px;
  }

  .product-ml__shipping {
    padding: 16px;
  }
}

/* ===============================================
   ACCESIBILIDAD
   =============================================== */
@media (prefers-reduced-motion: reduce) {
  .product-ml__media-track {
    animation: none;
  }

  .product-ml__main-image img {
    transition: none;
  }

  * {
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
  }
}

/* Focus visible para teclado */
.product-ml__thumbnail:focus-visible,
.product-ml__variant-button:focus-visible,
.product-ml__quantity-btn:focus-visible,
.product-ml__buy-button:focus-visible {
  outline: 2px solid var(--ml-color-primary);
  outline-offset: 2px;
}

/* ===============================================
   MEJORAS DE RENDIMIENTO
   =============================================== */
.product-ml__main-image img,
.product-ml__thumbnail img {
  image-rendering: -webkit-optimize-contrast;
  image-rendering: crisp-edges;
}

/* Carga de imágenes optimizada */
img[loading="lazy"] {
  content-visibility: auto;
}
