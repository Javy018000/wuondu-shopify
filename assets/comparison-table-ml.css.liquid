/* ===============================================
   TABLA COMPARATIVA MERCADO LIBRE
   =============================================== */

.comparison-ml {
  position: relative;
  padding: 60px 0;
}

/* Estilos de fondo opcionales */
.section-bg-white {
  background: #FFFFFF;
}

.section-bg-gray {
  background: linear-gradient(180deg, #FAFAFA 0%, #F5F5F5 100%);
}

.section-bg-orange-light {
  background: linear-gradient(180deg, #FFF9F5 0%, #FFE8DC 100%);
}

/* Glow decorativo */
.comparison-ml::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 200px;
  background: radial-gradient(circle at 50% 0%, rgba(255, 102, 0, 0.08) 0%, transparent 70%);
  pointer-events: none;
}

.section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top | default: 60 }}px;
  padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
}

.comparison-ml__heading {
  text-align: center;
  font-size: 36px;
  font-weight: 700;
  color: #1a1a1a;
  margin: 0 0 16px 0;
  line-height: 1.2;
  position: relative;
}

.comparison-ml__subtitle {
  text-align: center;
  font-size: 17px;
  color: #666;
  margin: 0 auto 50px auto;
  max-width: 700px;
  line-height: 1.6;
}

.comparison-ml__table-wrapper {
  max-width: 800px;
  margin: 0 auto;
  overflow-x: auto;
}

.comparison-ml__table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
  background: #fff;
}

.comparison-ml__table thead tr {
  background: linear-gradient(135deg, #FFF9F5 0%, #FFE8DC 100%);
}

.comparison-ml__table th {
  padding: 16px;
  text-align: center;
  font-size: 14px;
  font-weight: 600;
  color: #333;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.comparison-ml__header-empty {
  width: 50%;
  text-align: left;
}

.comparison-ml__header-us {
  width: 25%;
  background: linear-gradient(135deg, #FF6600 0%, #E85D00 100%);
  color: #fff;
  font-weight: 700;
  box-shadow: inset 0 -4px 8px rgba(0, 0, 0, 0.1);
}

.comparison-ml__header-others {
  width: 25%;
}

.comparison-ml__table tbody tr {
  border-bottom: 1px solid #e5e5e5;
}

.comparison-ml__table tbody tr:last-child {
  border-bottom: none;
}

.comparison-ml__table tbody tr:nth-child(even) {
  background: #fafafa;
}

.comparison-ml__feature-name {
  padding: 16px;
  font-size: 14px;
  color: #333;
  text-align: left;
  font-weight: 400;
}

.comparison-ml__cell-us,
.comparison-ml__cell-others {
  padding: 16px;
  text-align: center;
  vertical-align: middle;
}

.comparison-ml__cell-us {
  background: linear-gradient(135deg, rgba(255, 102, 0, 0.08) 0%, rgba(255, 102, 0, 0.05) 100%);
}

.comparison-ml__table tbody tr:hover {
  background: rgba(255, 102, 0, 0.03);
  transition: background 0.3s ease;
}

.comparison-ml__check,
.comparison-ml__cross {
  display: inline-block;
  vertical-align: middle;
}

/* ===============================================
   RESPONSIVE - TABLET
   =============================================== */
@media screen and (max-width: 989px) {
  .comparison-ml__heading {
    font-size: 28px;
  }

  .comparison-ml__subtitle {
    font-size: 15px;
  }

  .comparison-ml__table th,
  .comparison-ml__feature-name,
  .comparison-ml__cell-us,
  .comparison-ml__cell-others {
    padding: 12px 8px;
    font-size: 13px;
  }
}

/* ===============================================
   RESPONSIVE - M�VIL
   =============================================== */
@media screen and (max-width: 749px) {
  .comparison-ml__heading {
    font-size: 24px;
  }

  .comparison-ml__subtitle {
    font-size: 14px;
    margin-bottom: 30px;
  }

  .comparison-ml__table-wrapper {
    margin: 0 -20px;
    padding: 0 20px;
  }

  .comparison-ml__table th {
    font-size: 11px;
    padding: 10px 6px;
  }

  .comparison-ml__feature-name {
    font-size: 12px;
    padding: 12px 8px;
  }

  .comparison-ml__cell-us,
  .comparison-ml__cell-others {
    padding: 12px 6px;
  }

  .comparison-ml__check,
  .comparison-ml__cross {
    width: 20px;
    height: 20px;
  }
}
